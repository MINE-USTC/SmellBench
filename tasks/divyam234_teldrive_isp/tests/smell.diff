+package transfer
+
+import (
+	"context"
+	"io"
+
+	"github.com/google/uuid"
+	"github.com/tgdrive/teldrive/v2/internal/db/sqlcgen"
+	"github.com/tgdrive/teldrive/v2/internal/telegramstore"
+)
+
+type downloadScope interface {
+	downloadBackend
+	telegramstore.DownloadSession
+	SizePersistence() (PartSizeBackfiller, PartSizeBatchBackfiller)
+	StoreResolvedSize(*sqlcgen.FilePart, int64, int64)
+	CommitSizes(context.Context, uuid.UUID) error
+}
+
+type downloadRequestBinding struct {
+	downloadBackend
+	session telegramstore.DownloadSession
+	one     PartSizeBackfiller
+	many    PartSizeBatchBackfiller
+	sizes   map[int32][2]int64
+}
+
+func (b downloadBinding) Download(ctx context.Context, userID int64, unavailable error) (telegramstore.DownloadSession, error) {
+	if opener := b.SessionSource(); opener != nil {
+		return opener.OpenDownloadSession(ctx, userID)
+	}
+	return borrowedDownload{downloadBackend: b, metadata: b.MetadataSource(), unavailable: unavailable}, nil
+}
+
+type borrowedDownload struct {
+	downloadBackend
+	metadata    telegramstore.MetadataReader
+	unavailable error
+}
+
+func (b borrowedDownload) Metadata(ctx context.Context, request telegramstore.MetadataRequest) (telegramstore.StoredPart, error) {
+	if b.metadata == nil {
+		return telegramstore.StoredPart{}, b.unavailable
+	}
+	return b.metadata.Metadata(ctx, request)
+}
+
+func (borrowedDownload) Close() error { return nil }
+
+func (d *Downloader) requestBackend(session telegramstore.DownloadSession) downloadScope {
+	one, _ := d.catalog.(PartSizeBackfiller)
+	many, _ := d.catalog.(PartSizeBatchBackfiller)
+	return &downloadRequestBinding{downloadBackend: d.backend(), session: session, one: one, many: many, sizes: make(map[int32][2]int64)}
+}
+
+func (b *downloadRequestBinding) Metadata(ctx context.Context, req telegramstore.MetadataRequest) (telegramstore.StoredPart, error) {
+	return b.session.Metadata(ctx, req)
+}
+
+func (b *downloadRequestBinding) OpenRange(ctx context.Context, req telegramstore.RangeRequest) (io.ReadCloser, error) {
+	return b.session.OpenRange(ctx, req)
+}
+
+func (b *downloadRequestBinding) Close() error { return b.session.Close() }
+
+func (b *downloadRequestBinding) SizePersistence() (PartSizeBackfiller, PartSizeBatchBackfiller) {
+	return b.one, b.many
+}
+
+func (b *downloadRequestBinding) StoreResolvedSize(part *sqlcgen.FilePart, plainSize, storedSize int64) {
+	part.StoredSize.Int64, part.StoredSize.Valid = storedSize, true
+	part.PlainSize.Int64, part.PlainSize.Valid = plainSize, true
+	if b.many != nil {
+		b.sizes[part.PartNo] = [2]int64{plainSize, storedSize}
+	}
+}
+
+func (b *downloadRequestBinding) CommitSizes(ctx context.Context, fileID uuid.UUID) error {
+	if b.many != nil && len(b.sizes) > 0 {
+		return b.many.UpdatePartSizesMany(ctx, fileID, b.sizes)
+	}
+	return nil
+}
