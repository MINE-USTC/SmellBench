+package telegramstore
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/gotd/td/tg"
+)
+
+type storageRuntime interface {
+	Runner
+	PooledRunner
+	BotProvider
+	CachedSessions() DownloadSessionOpener
+	StartSession(context.Context, int64) *gotdDownloadSession
+	ChannelBotsFor(context.Context, int64, *tg.Client, *tg.Channel) ([]tg.InputUserClass, error)
+}
+
+type runtimeBinding struct{ storage *GotdStorage }
+
+func (s *GotdStorage) runtime() storageRuntime { return runtimeBinding{storage: s} }
+
+func (r runtimeBinding) Run(ctx context.Context, userID int64, operation Operation, fn func(context.Context, *tg.Client) error) error {
+	return r.storage.runner.Run(ctx, userID, operation, fn)
+}
+
+func (r runtimeBinding) RunPooled(ctx context.Context, userID int64, operation Operation, connections int, fn func(context.Context, *tg.Client) error) error {
+	if pooled, ok := r.storage.runner.(PooledRunner); ok && connections > 1 {
+		return pooled.RunPooled(ctx, userID, operation, connections, fn)
+	}
+	return r.Run(ctx, userID, operation, fn)
+}
+
+func (r runtimeBinding) ChannelBots(ctx context.Context, userID int64, api *tg.Client) ([]tg.InputUserClass, error) {
+	if r.storage.botProvider == nil {
+		return nil, nil
+	}
+	return r.storage.botProvider.ChannelBots(ctx, userID, api)
+}
+
+func (r runtimeBinding) CachedSessions() DownloadSessionOpener {
+	if r.storage.downloadPool != nil {
+		return r.storage.downloadPool
+	}
+	return nil
+}
+
+func (r runtimeBinding) StartSession(ctx context.Context, userID int64) *gotdDownloadSession {
+	sessionCtx, cancel := context.WithCancel(ctx)
+	session := &gotdDownloadSession{
+		ctx: sessionCtx, cancel: cancel, ready: make(chan struct{}), done: make(chan struct{}),
+		downloadReadBuffers:  r.storage.downloadReadBuffers,
+		downloadReadParallel: r.storage.downloadReadParallel,
+		globalCache:          r.storage.globalCache,
+	}
+	go func() {
+		err := r.RunPooled(sessionCtx, userID, OperationDownload, r.storage.downloadReadParallel, func(runCtx context.Context, api *tg.Client) error {
+			session.mu.Lock()
+			session.api = api
+			session.clientID, _ = ClientID(runCtx)
+			session.mu.Unlock()
+			close(session.ready)
+			<-runCtx.Done()
+			return runCtx.Err()
+		})
+		session.mu.Lock()
+		session.err = err
+		session.mu.Unlock()
+		close(session.done)
+	}()
+	return session
+}
+
+func (r runtimeBinding) ChannelBotsFor(ctx context.Context, userID int64, api *tg.Client, channel *tg.Channel) ([]tg.InputUserClass, error) {
+	bots, err := r.ChannelBots(ctx, userID, api)
+	if err != nil {
+		_, _ = api.ChannelsDeleteChannel(ctx, channel.AsInput())
+		return nil, fmt.Errorf("resolve Telegram upload bots: %w", err)
+	}
+	return bots, nil
+}
