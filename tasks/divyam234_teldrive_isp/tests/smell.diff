new file mode 100644
index 0000000..6c5ac21
--- /dev/null
+++ b/internal/telegramstore/copy_backend.go
@@ -0,0 +1,35 @@
+package telegramstore
+
+import "context"
+
+type CopyBackend interface {
+	Backend
+	RollbackCopies(context.Context, int64)
+}
+
+type copyBackend struct {
+	Backend
+	parts []StoredPart
+}
+
+func BindCopy(storage Backend) CopyBackend { return &copyBackend{Backend: storage} }
+
+func (b *copyBackend) CopyPart(ctx context.Context, userID, sourceChannelID, sourceMessageID, destinationChannelID int64) (StoredPart, error) {
+	stored, err := b.Backend.CopyPart(ctx, userID, sourceChannelID, sourceMessageID, destinationChannelID)
+	if err == nil {
+		b.parts = append(b.parts, stored)
+	}
+	return stored, err
+}
+
+func (b *copyBackend) RollbackCopies(ctx context.Context, userID int64) {
+	grouped := make(map[int64][]int64)
+	for _, part := range b.parts {
+		if part.ChannelID != 0 && part.MessageID > 0 {
+			grouped[part.ChannelID] = append(grouped[part.ChannelID], part.MessageID)
+		}
+	}
+	for channelID, ids := range grouped {
+		_ = b.DeleteMessages(ctx, userID, channelID, ids)
+	}
+}
