diff --git a/internal/telegramstore/backend.go b/internal/telegramstore/backend.go
new file mode 100644
index 0000000..9ae2bb7
--- /dev/null
+++ b/internal/telegramstore/backend.go
@@ -0,0 +1,120 @@
+package telegramstore
+
+import (
+	"context"
+	"fmt"
+	"io"
+)
+
+type Backend interface {
+	Storage
+	Download(context.Context, int64, error) (DownloadSession, error)
+	DocumentInventory() DocumentMessageLister
+	BotAdministration() BotInviter
+	MetadataSource() MetadataReader
+	SessionSource() DownloadSessionOpener
+	WalkDocuments(context.Context, ListDocumentMessagesRequest, func(DocumentMessagePage) ([]int64, error)) (int, error)
+}
+
+type backend struct{ Storage }
+
+func BindBackend(storage Storage) Backend {
+	if storage == nil {
+		return nil
+	}
+	if bound, ok := storage.(Backend); ok {
+		return bound
+	}
+	return backend{Storage: storage}
+}
+
+func (b backend) Download(ctx context.Context, userID int64, unavailable error) (DownloadSession, error) {
+	if opener := b.SessionSource(); opener != nil {
+		return opener.OpenDownloadSession(ctx, userID)
+	}
+	return backendDownload{Backend: b, unavailable: unavailable}, nil
+}
+
+func (b backend) MetadataSource() MetadataReader {
+	reader, _ := b.Storage.(MetadataReader)
+	return reader
+}
+
+func (b backend) SessionSource() DownloadSessionOpener {
+	opener, _ := b.Storage.(DownloadSessionOpener)
+	return opener
+}
+
+func (b backend) DocumentInventory() DocumentMessageLister {
+	lister, _ := b.Storage.(DocumentMessageLister)
+	return lister
+}
+
+type inventoryBackend struct {
+	Backend
+	inventory DocumentMessageLister
+}
+
+func BindInventory(storage Storage, inventory DocumentMessageLister) Backend {
+	return inventoryBackend{Backend: BindBackend(storage), inventory: inventory}
+}
+
+func (b inventoryBackend) DocumentInventory() DocumentMessageLister { return b.inventory }
+
+func (b inventoryBackend) WalkDocuments(ctx context.Context, request ListDocumentMessagesRequest, consume func(DocumentMessagePage) ([]int64, error)) (int, error) {
+	return walkDocuments(ctx, b, request, consume)
+}
+
+func (b backend) WalkDocuments(ctx context.Context, request ListDocumentMessagesRequest, consume func(DocumentMessagePage) ([]int64, error)) (int, error) {
+	return walkDocuments(ctx, b, request, consume)
+}
+
+func walkDocuments(ctx context.Context, b Backend, request ListDocumentMessagesRequest, consume func(DocumentMessagePage) ([]int64, error)) (int, error) {
+	deleted := 0
+	for {
+		page, err := b.DocumentInventory().ListDocumentMessages(ctx, request)
+		if err != nil {
+			return deleted, fmt.Errorf("list Telegram documents for channel %d: %w", request.ChannelID, err)
+		}
+		ids, err := consume(page)
+		if err != nil {
+			return deleted, err
+		}
+		if len(ids) > 0 {
+			if err := b.DeleteMessages(ctx, request.UserID, request.ChannelID, ids); err != nil {
+				return deleted, fmt.Errorf("delete orphaned Telegram documents from channel %d: %w", request.ChannelID, err)
+			}
+			deleted += len(ids)
+		}
+		if page.Exhausted {
+			return deleted, nil
+		}
+		if page.BeforeID <= 0 || page.BeforeID == request.BeforeID {
+			return deleted, fmt.Errorf("list Telegram documents for channel %d: pagination did not advance", request.ChannelID)
+		}
+		request.BeforeID = page.BeforeID
+	}
+}
+
+func (b backend) BotAdministration() BotInviter {
+	inviter, _ := b.Storage.(BotInviter)
+	return inviter
+}
+
+type backendDownload struct {
+	Backend
+	unavailable error
+}
+
+func (s backendDownload) Metadata(ctx context.Context, request MetadataRequest) (StoredPart, error) {
+	if reader := s.Backend.MetadataSource(); reader != nil {
+		return reader.Metadata(ctx, request)
+	}
+	return StoredPart{}, s.unavailable
+}
+
+func (s backendDownload) OpenRange(ctx context.Context, request RangeRequest) (io.ReadCloser, error) {
+	return s.Backend.OpenRange(ctx, request)
+}
+
+func (backendDownload) Close() error { return nil }
