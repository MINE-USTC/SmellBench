+++ b/internal/jobs/cleanup_backend.go
@@ -0,0 +1,37 @@
+package jobs
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/tgdrive/teldrive/v2/internal/db/sqlcgen"
+	"github.com/tgdrive/teldrive/v2/internal/telegramstore"
+)
+
+type cleanupBackend struct {
+	telegramstore.Backend
+	queries *sqlcgen.Queries
+	records []cleanupPartRecord
+}
+
+func bindCleanup(storage telegramstore.Backend, queries *sqlcgen.Queries, records []cleanupPartRecord) telegramstore.Backend {
+	return cleanupBackend{Backend: storage, queries: queries, records: records}
+}
+
+func (b cleanupBackend) DeleteMessages(ctx context.Context, userID, channelID int64, ids []int64) error {
+	if err := b.Backend.DeleteMessages(ctx, userID, channelID, ids); err != nil {
+		return fmt.Errorf("delete Telegram upload messages for user %d channel %d: %w", userID, channelID, err)
+	}
+	encoded, err := json.Marshal(b.records)
+	if err != nil {
+		return fmt.Errorf("encode cleaned upload parts: %w", err)
+	}
+	deleted, err := b.queries.DeleteUploadPartsForCleanup(ctx, encoded)
+	if err != nil {
+		return fmt.Errorf("delete upload parts after Telegram cleanup: %w", err)
+	}
+	if deleted != int64(len(b.records)) {
+		return fmt.Errorf("%d upload parts changed during cleanup", int64(len(b.records))-deleted)
+	}
+	return nil
+}
