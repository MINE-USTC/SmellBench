@@ -0,0 +1,70 @@
+package transfer
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/google/uuid"
+	"github.com/tgdrive/teldrive/v2/internal/db/sqlcgen"
+	"github.com/tgdrive/teldrive/v2/internal/telegramstore"
+	"github.com/tgdrive/teldrive/v2/internal/uploads"
+	"time"
+)
+
+func (b uploadBinding) StoreUploaded(storeCtx, cleanupCtx context.Context, userID int64, stored telegramstore.StoredPart, input uploads.StorePartInput) (*sqlcgen.UploadPart, error) {
+	part, err := b.StorePart(storeCtx, input)
+	if err != nil {
+		return nil, errors.Join(err, b.RemoveUploaded(cleanupCtx, userID, stored))
+	}
+	return part, nil
+}
+
+func (b uploadBinding) AbortPart(ctx context.Context, request UploadPartRequest, leaseToken uuid.UUID, code string) error {
+	cleanupCtx, cancel := partCleanupContext(ctx)
+	defer cancel()
+	_, failErr := b.FailPart(cleanupCtx, uploads.FailPartInput{
+		UploadID:   request.UploadID,
+		PartNo:     request.PartNo,
+		LeaseToken: leaseToken,
+		ErrorCode:  code,
+	})
+	return failErr
+}
+
+func (b uploadBinding) RenewPart(ctx context.Context, input uploads.RenewPartInput) error {
+	renewCtx, stop := partCleanupContext(ctx)
+	err := b.UploadCatalog.RenewPart(renewCtx, input)
+	stop()
+	return err
+}
+
+func (b uploadBinding) KeepLease(ctx context.Context, request UploadPartRequest, leaseToken uuid.UUID, failed func(error)) {
+	go func() {
+		ticker := time.NewTicker(b.config.LeaseRenewInterval)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				err := b.RenewPart(ctx, uploads.RenewPartInput{
+					UploadID: request.UploadID, PartNo: request.PartNo, LeaseToken: leaseToken,
+				})
+				if err != nil {
+					failed(err)
+					return
+				}
+			}
+		}
+	}()
+}
+
+func (b uploadBinding) RemoveUploaded(ctx context.Context, userID int64, part telegramstore.StoredPart) error {
+	if part.ChannelID == 0 || part.MessageID <= 0 {
+		return nil
+	}
+	if err := b.DeleteMessages(ctx, userID, part.ChannelID, []int64{part.MessageID}); err != nil {
+		return fmt.Errorf("compensate Telegram upload: %w", err)
+	}
+	return nil
+}
