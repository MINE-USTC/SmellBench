diff --git a/serf/coordinate_payload.go b/serf/coordinate_payload.go
new file mode 100644
index 0000000..c66923a
--- /dev/null
+++ b/serf/coordinate_payload.go
@@ -0,0 +1,49 @@
+// Copyright IBM Corp. 2013, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package serf
+
+import (
+	"bytes"
+	"time"
+
+	"github.com/hashicorp/go-msgpack/v2/codec"
+	"github.com/hashicorp/memberlist"
+	"github.com/hashicorp/serf/coordinate"
+)
+
+type coordinatePayload struct {
+	version    byte
+	coordinate coordinate.Coordinate
+	err        error
+}
+
+func readCoordinate(payload []byte) coordinatePayload {
+	p := coordinatePayload{version: payload[0]}
+	if p.version == PingVersion {
+		p.err = codec.NewDecoder(bytes.NewReader(payload[1:]), &codec.MsgpackHandle{}).Decode(&p.coordinate)
+	}
+	return p
+}
+
+type coordinateUpdate struct {
+	packet coordinatePayload
+	before *coordinate.Coordinate
+	after  *coordinate.Coordinate
+	err    error
+}
+
+func (p *pingDelegate) updateCoordinate(other *memberlist.Node, rtt time.Duration, payload coordinatePayload) (coordinateUpdate, bool) {
+	update := coordinateUpdate{packet: payload}
+	if payload.version != PingVersion {
+		p.serf.logger.Printf("[ERR] serf: Unsupported ping version: %v", payload.version)
+		return update, false
+	}
+	if payload.err != nil {
+		p.serf.logger.Printf("[ERR] serf: Failed to decode coordinate from ping: %v", payload.err)
+		return update, false
+	}
+	update.before = p.serf.coordClient.GetCoordinate()
+	update.after, update.err = p.serf.coordClient.Update(other.Name, &update.packet.coordinate, rtt)
+	return update, true
+}
