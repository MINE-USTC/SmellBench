--- /dev/null
+++ b/serf/query_filter.go
@@ -0,0 +1,49 @@
+// Copyright IBM Corp. 2013, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package serf
+
+import "regexp"
+
+type receivedFilter struct {
+	kind       filterType
+	nodes      filterNode
+	tag        filterTag
+	expression *regexp.Regexp
+	err        error
+	patternErr error
+}
+
+func readFilter(buf []byte) receivedFilter {
+	f := receivedFilter{kind: filterType(buf[0])}
+	switch f.kind {
+	case filterNodeType:
+		f.err = decodeMessage(buf[1:], &f.nodes)
+	case filterTagType:
+		f.err = decodeMessage(buf[1:], &f.tag)
+		if f.err == nil {
+			f.expression, f.patternErr = regexp.Compile(f.tag.Expr)
+		}
+	}
+	return f
+}
+
+func (s *Serf) acceptFilter(f receivedFilter) bool {
+	if f.kind != filterNodeType && f.kind != filterTagType {
+		s.logger.Printf("[WARN] serf: query has unrecognized filter type: %d", f.kind)
+		return false
+	}
+	if f.err != nil {
+		if f.kind == filterNodeType {
+			s.logger.Printf("[WARN] serf: failed to decode filterNodeType: %v", f.err)
+		} else {
+			s.logger.Printf("[WARN] serf: failed to decode filterTagType: %v", f.err)
+		}
+		return false
+	}
+	if f.patternErr != nil {
+		s.logger.Printf("[WARN] serf: failed to compile filter regex (%s): %v", f.tag.Expr, f.patternErr)
+		return false
+	}
+	return true
+}
diff --git a/serf/receive.go b/serf/receive.go
new file mode 100644
index 0000000..e7f7d2b
--- /dev/null
+++ b/serf/receive.go
@@ -0,0 +1,124 @@
+// Copyright IBM Corp. 2013, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package serf
+
+import (
+	"bytes"
+
+	"github.com/hashicorp/go-msgpack/v2/codec"
+	"github.com/hashicorp/memberlist"
+)
+
+type receivedMessage struct {
+	kind  messageType
+	value any
+	err   error
+	raw   []byte
+}
+
+func readMessage(buf []byte) receivedMessage {
+	m := receivedMessage{kind: messageType(buf[0])}
+	switch m.kind {
+	case messageLeaveType:
+		m.value = &messageLeave{}
+	case messageJoinType:
+		m.value = &messageJoin{}
+	case messageUserEventType:
+		m.value = &messageUserEvent{}
+	case messageQueryType:
+		m.value = &messageQuery{}
+	case messageQueryResponseType:
+		m.value = &messageQueryResponse{}
+	case messageRelayType:
+		m.value = &relayHeader{}
+		reader := bytes.NewReader(buf[1:])
+		m.err = codec.NewDecoder(reader, &codec.MsgpackHandle{}).Decode(m.value)
+		if m.err == nil {
+			m.raw = make([]byte, reader.Len())
+			_, _ = reader.Read(m.raw)
+		}
+		return m
+	default:
+		return m
+	}
+	m.err = decodeMessage(buf[1:], m.value)
+	return m
+}
+
+func (d *delegate) acceptMessage(m receivedMessage) bool {
+	if m.value == nil {
+		d.serf.logger.Printf("[WARN] serf: Received message of unknown type: %d", m.kind)
+		return false
+	}
+	if m.err == nil {
+		return true
+	}
+	switch m.kind {
+	case messageLeaveType:
+		d.serf.logger.Printf("[ERR] serf: Error decoding leave message: %s", m.err)
+	case messageJoinType:
+		d.serf.logger.Printf("[ERR] serf: Error decoding join message: %s", m.err)
+	case messageUserEventType:
+		d.serf.logger.Printf("[ERR] serf: Error decoding user event message: %s", m.err)
+	case messageQueryType:
+		d.serf.logger.Printf("[ERR] serf: Error decoding query message: %s", m.err)
+	case messageQueryResponseType:
+		d.serf.logger.Printf("[ERR] serf: Error decoding query response message: %s", m.err)
+	case messageRelayType:
+		d.serf.logger.Printf("[ERR] serf: Error decoding relay header: %s", m.err)
+	}
+	return false
+}
+
+func (d *delegate) forwardRelay(m receivedMessage) error {
+	header := m.value.(*relayHeader)
+	addr := memberlist.Address{
+		Addr: header.DestAddr.String(),
+		Name: header.DestName,
+	}
+	d.serf.logger.Printf("[DEBUG] serf: Relaying response to addr: %s", addr.Addr)
+	return d.serf.memberlist.SendToAddress(addr, m.raw)
+}
+
+type remoteState struct {
+	message messagePushPull
+	err     error
+}
+
+func readRemoteState(buf []byte) remoteState {
+	var state remoteState
+	state.err = decodeMessage(buf, &state.message)
+	return state
+}
+
+func (d *delegate) acceptRemoteState(state remoteState) bool {
+	if state.err != nil {
+		d.serf.logger.Printf("[ERR] serf: Failed to decode remote state: %v", state.err)
+		return false
+	}
+	return true
+}
+
+type remoteMembership struct {
+	leaves []messageLeave
+	joins  map[string]LamportTime
+}
+
+func membershipFromState(pp messagePushPull) remoteMembership {
+	membership := remoteMembership{
+		leaves: make([]messageLeave, 0, len(pp.LeftMembers)),
+		joins:  make(map[string]LamportTime, len(pp.StatusLTimes)),
+	}
+	for name, clock := range pp.StatusLTimes {
+		membership.joins[name] = clock
+	}
+	for _, name := range pp.LeftMembers {
+		membership.leaves = append(membership.leaves, messageLeave{
+			Node:  name,
+			LTime: pp.StatusLTimes[name] + 1,
+		})
+		delete(membership.joins, name)
+	}
+	return membership
+}
