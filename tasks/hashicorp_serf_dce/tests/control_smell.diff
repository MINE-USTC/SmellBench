+// Copyright IBM Corp. 2013, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package serf
+
+func prepareUserEpoch(events map[string]*latestUserEvents, user UserEvent) {
+	latest, exists := events[user.Name]
+	if !exists || latest.LTime < user.LTime {
+		events[user.Name] = &latestUserEvents{LTime: user.LTime}
+	}
+}
+
+func prepareMemberGroups(latest map[string]coalesceEvent, previous map[string]EventType) map[EventType]*MemberEvent {
+	groups := make(map[EventType]*MemberEvent)
+	for name, event := range latest {
+		if old, exists := previous[name]; exists && old == event.Type && event.Type != EventMemberUpdate {
+			continue
+		}
+		if _, exists := groups[event.Type]; !exists {
+			groups[event.Type] = &MemberEvent{Type: event.Type}
+		}
+	}
+	return groups
+}
