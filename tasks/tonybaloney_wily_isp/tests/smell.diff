diff --git a/src/wily/session.py b/src/wily/session.py
new file mode 100644
index 0000000..bf7a520
--- /dev/null
+++ b/src/wily/session.py
@@ -0,0 +1,160 @@
+"""Command session support."""
+
+from dataclasses import dataclass
+
+
+@dataclass
+class RuntimeBindings:
+    """Dependencies for a command session."""
+
+    index_type: object
+    revision_lookup: object
+    file_iterator: object
+    archiver: object
+
+
+class CommandSession:
+    """Command session state."""
+
+    def __init__(self, config, parquet_path, operators, bindings):
+        """Bind configuration and the storage implementation."""
+        self.config = config
+        self.parquet_path = parquet_path
+        self.operators = operators
+        self.bindings = bindings
+
+    def checkout(self, revision, options):
+        """Switch the attached source to the requested revision."""
+        result = self.bindings.archiver.checkout(revision, options)
+        self.active_revision = revision
+        return result
+
+    def finish(self):
+        """Restore source ownership after indexing."""
+        return self.bindings.archiver.finish()
+
+    def __enter__(self):
+        """Open the command's store."""
+        self.store = self.bindings.index_type(self.parquet_path, self.operators)
+        self.index = self.store.__enter__()
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        """Close the current index."""
+        return self.store.__exit__(exc_type, exc_value, traceback)
+
+    def __iter__(self):
+        """Iterate stored rows."""
+        return iter(self.index)
+
+    def __getitem__(self, path):
+        """Read the cached rows for a path."""
+        return self.index[path]
+
+    def analyze_revision(self, **kwargs):
+        """Append analysis for one historical revision."""
+        if 'revision_key' not in kwargs:
+            revision = self.describe(self.active_revision, required=True)
+            kwargs.update(revision_key=revision['key'], revision_date=revision['date'],
+                          revision_author=revision['author'], revision_message=revision['message'])
+        return self.index.analyze_revision(**kwargs)
+
+    def analyze_files(self, paths, base_path, detail):
+        """Analyze working-tree files without appending rows."""
+        return self.index.analyze_files(paths, base_path, detail)
+
+    def find(self, search):
+        """Resolve a source revision."""
+        return self.bindings.revision_lookup(self.config.path, search)
+
+    def files(self, targets):
+        """Discover source files."""
+        return self.bindings.file_iterator(targets)
+
+    def revisions(self, reverse=False):
+        """Read revision metadata from the active store."""
+        return self.catalog(self, reverse)
+
+    def catalog(self, rows, reverse=False):
+        """List revisions in the given rows."""
+        revisions = {}
+        for row in self.scan(rows):
+            key = row['revision']
+            if key not in revisions:
+                revisions[key] = self.describe(row, cached=True)
+        return sorted(revisions.values(), key=lambda revision: revision['date'], reverse=reverse)
+
+    def current(self, paths, detail):
+        """Analyze the current files."""
+        return self.analyze_files(paths, str(self.config.path), detail)
+
+    def history(self, path, n):
+        """Select rows for the report path."""
+        rows = self.path_rows(path, granular=':' in path)
+        return sorted(rows, key=lambda row: row.get('revision_date', 0))[-(n or len(rows)):]
+
+    def path_rows(self, path, granular=True):
+        """Return rows for a path."""
+        rows = self[path]
+        return list(self.scan(rows, granular=granular))
+
+    def describe(self, revision, cached=False, required=False, author_default='Unknown'):
+        """Return revision details."""
+        if not cached and isinstance(revision, str):
+            revision = self.find(revision)
+        if revision is None:
+            return None
+        identity = {'key': revision['revision' if cached else 'key']}
+        for field, source_field, default in (
+            ('date', 'date', 0), ('author', 'author_name', author_default),
+            ('message', 'message', ''),
+        ):
+            storage_field = 'revision_' + field if cached else source_field
+            identity[field] = revision[storage_field] if required else revision.get(storage_field, default)
+        return identity
+
+    def scan(self, rows=None, revision=None, granular=True, path=None):
+        """Iterate rows matching the given filters."""
+        for row in self if rows is None else rows:
+            if revision is not None and row.get('revision') != revision:
+                continue
+            if not granular and row.get('path_type') != 'file':
+                continue
+            if path is not None:
+                candidate = row['path']
+                if not (candidate.startswith(path) or path.startswith(candidate)):
+                    continue
+            yield row
+
+    def select(self, rows, revision=None, source=False):
+        """Select a row and its revision details."""
+        if source and revision:
+            metadata = self.find(revision)
+            if not metadata:
+                return None, None
+            key = metadata['key']
+        else:
+            metadata = None
+            key = revision
+        if key:
+            row = next(self.scan(rows, revision=key), None)
+        elif source:
+            ordered = sorted(rows, key=lambda item: item.get('revision_date', 0), reverse=True)
+            row = ordered[0] if ordered else None
+        else:
+            row = rows[-1] if rows else None
+        return row, metadata
+
+    def values(self, row):
+        """Return metric values from a row."""
+        return {key: value for key, value in row.items() if key not in (
+            'revision', 'revision_date', 'revision_author', 'revision_message', 'path', 'path_type')}
+
+    def metric_rows(self, revision, name):
+        """Read one metric's per-path values."""
+        result = {}
+        for row in self.scan(revision=revision):
+            value = row.get(name)
+            if value is not None:
+                result[row['path']] = value
+        return result
