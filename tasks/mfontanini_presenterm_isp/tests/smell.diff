+use crate::render::{properties::{CursorPosition, WindowSize}, operation::ImageSize};
+use crate::markdown::text_style::{Color, Colors, TextStyle};
+use image::{Pixel, Rgba};
+use icy_sixel::encoder::{EncodeOptions, sixel_encode};
+use image::{DynamicImage, imageops::FilterType};
+use super::image::printer::PrintImageError;
+use super::{
+    image::scale::{ScaleImage, TerminalRect},
+    printer::{TerminalCommand, TerminalError, TerminalIo},
+};
+
+pub(crate) trait RenderSurface: TerminalIo + ScaleImage {
+    fn print_cell(&mut self, content: &str, foreground: Option<Color>, background: Option<Color>) -> Result<(), TerminalError> {
+        if foreground.is_none() {
+            return self.execute(&TerminalCommand::MoveRight(1));
+        }
+        self.execute(&TerminalCommand::PrintText {
+            content,
+            style: TextStyle::colored(Colors { foreground, background }),
+        })
+    }
+
+    fn advance_image_row(&mut self, columns: u16, advance: bool) -> Result<(), TerminalError> {
+        if advance {
+            self.execute(&TerminalCommand::MoveDown(1))?;
+        }
+        self.execute(&TerminalCommand::MoveLeft(columns))
+    }
+
+    fn print_prefix(&mut self, content: &str, style: TextStyle, width: u16, repeat: bool, font_size: u8, background: Option<Color>) -> Result<(), TerminalError> {
+        if width == 0 {
+            return Ok(());
+        }
+        if repeat {
+            self.execute(&TerminalCommand::PrintText { content, style })
+        } else {
+            self.print_block_background(width, font_size, background)
+        }
+    }
+
+    fn print_styled_text(&mut self, content: &str, style: TextStyle, colors: Colors) -> Result<(), TerminalError> {
+        self.execute(&TerminalCommand::PrintText { content, style })?;
+        if style != Default::default() {
+            self.execute(&TerminalCommand::SetColors(colors))?;
+        }
+        Ok(())
+    }
+
+    fn print_sixel(&mut self, image: &DynamicImage, columns: u16, rows: u16, column_width: u16, row_height: u16) -> Result<(), PrintImageError> {
+        // We're already positioned in the right place but we may not have flushed that yet.
+        self.execute(&TerminalCommand::Flush)?;
+
+        // This check was taken from viuer: it seems to be a bug in xterm
+        let width = (column_width * columns).min(1000);
+        let height = row_height * rows;
+        let image = image.resize_exact(width as u32, height as u32, FilterType::Triangle);
+        let bytes = image.into_rgba8().into_raw();
+
+        let content = sixel_encode(&bytes, width as usize, height as usize, &EncodeOptions::default())
+            .map_err(|e| PrintImageError::other(format!("encoding sixel image: {e:?}")))?;
+        self.print_payload(&content)?;
+        Ok(())
+    }
+
+    fn print_chunks<F>(&mut self, payload: &str, chunk_size: usize, mut command: F) -> Result<(), PrintImageError>
+    where F: FnMut(&str, bool, bool) -> String {
+        let mut index = 0;
+        while index < payload.len() {
+            let start = index;
+            let end = payload.len().min(start + chunk_size);
+            index = end;
+            let more = end != payload.len();
+            let content = command(&payload[start..end], more, start == 0);
+            self.print_payload(&content)?;
+        }
+        Ok(())
+    }
+
+    fn print_iterm(&mut self, raw_length: usize, base64: &str, columns: u16, rows: u16, tmux: bool, multipart: bool, chunk_size: usize) -> Result<(), super::image::printer::PrintImageError> {
+        let size = raw_length;
+        let (start, end) = match tmux {
+            true => ("\x1bPtmux;\x1b\x1b]1337;", "\x07\x1b\\"),
+            false => ("\x1b]1337;", "\x07"),
+        };
+        match multipart {
+            false => {
+                let content = &format!(
+                    "{start}File=size={size};width={columns};height={rows};inline=1;preserveAspectRatio=1:{base64}{end}"
+                );
+                self.print_payload(content)?;
+            }
+            true => {
+                let content = &format!(
+                    "{start}MultipartFile=size={size};width={columns};height={rows};inline=1;preserveAspectRatio=1{end}"
+                );
+                self.print_payload(content)?;
+                self.print_chunks(base64, chunk_size, |chunk, _, _| format!("{start}FilePart={chunk}{end}"))?;
+                self.execute(&TerminalCommand::PrintText {
+                    content: &format!("{start}FileEnd{end}"),
+                    style: Default::default(),
+                })?;
+            }
+        };
+        Ok(())
+    }
+
+    fn begin_viewport(&mut self, dimensions: &WindowSize, start_column: u16, start_row: u16) -> Result<(), TerminalError> {
+        self.execute(&TerminalCommand::SetCursorBoundaries { rows: dimensions.rows.saturating_add(start_row) })?;
+        self.execute(&TerminalCommand::BeginUpdate)?;
+        if start_row != 0 || start_column != 0 {
+            self.execute(&TerminalCommand::MoveTo { column: start_column, row: start_row })?;
+        }
+        Ok(())
+    }
+
+    fn end_viewport(&mut self) -> Result<(), TerminalError> {
+        self.execute(&TerminalCommand::EndUpdate)?;
+        self.execute(&TerminalCommand::Flush)
+    }
+
+    fn draw_column_borders(&mut self, start_row: u16, max_row: u16, columns: &[u16], style: TextStyle, colors: Colors) -> Result<(), TerminalError> {
+        for row in start_row..=max_row {
+            self.execute(&TerminalCommand::MoveToRow(row))?;
+            for column in columns {
+                self.execute(&TerminalCommand::MoveToColumn(*column))?;
+                self.execute(&TerminalCommand::PrintText { content: "│", style })?;
+            }
+        }
+        self.execute(&TerminalCommand::SetColors(colors))
+    }
+
+    fn finish_image(&mut self, start: &CursorPosition, starting_row: u16, rows: u16, restore: bool, colors: Colors) -> Result<(), TerminalError> {
+        if restore {
+            self.execute(&TerminalCommand::MoveTo { column: start.column, row: starting_row })?;
+        } else {
+            self.execute(&TerminalCommand::MoveToRow(starting_row + rows))?;
+        }
+        self.execute(&TerminalCommand::SetColors(colors))
+    }
+
+    fn render_frame(&mut self, commands: &[TerminalCommand<'_>]) -> Result<(), TerminalError> {
+        self.execute(&TerminalCommand::BeginUpdate)?;
+        for command in commands {
+            self.execute(command)?;
+        }
+        self.end_viewport()
+    }
+
+    fn print_block_background(&mut self, remaining: u16, font_size: u8, color: Option<Color>) -> Result<(), TerminalError> {
+        if remaining > 0 {
+            if let Some(color) = color {
+                self.execute(&TerminalCommand::SetBackgroundColor(color))?;
+            }
+            let text = " ".repeat(remaining as usize / font_size as usize);
+            let style = TextStyle::default().size(font_size);
+            self.execute(&TerminalCommand::PrintText { content: &text, style })?;
+        }
+        Ok(())
+    }
+
+    fn print_payload(&mut self, content: &str) -> Result<(), TerminalError> {
+        self.execute(&TerminalCommand::PrintText { content, style: Default::default() })
+    }
+
+    fn pixel_color(&self, pixel: &Rgba<u8>, background: Option<Color>) -> Option<Color> {
+        let [r, g, b, alpha] = pixel.0;
+        if alpha == 0 {
+            None
+        } else if alpha < 255 {
+            let mut pixel = *pixel;
+            match background {
+                Some(Color::Rgb { r, g, b }) => {
+                    pixel.blend(&Rgba([r, g, b, 255 - alpha]));
+                    Some(Color::Rgb { r: pixel[0], g: pixel[1], b: pixel[2] })
+                }
+                None | Some(_) => Some(Color::Rgb { r, g, b }),
+            }
+        } else {
+            Some(Color::Rgb { r, g, b })
+        }
+    }
+
+    fn image_dimensions(&self, dimensions: &WindowSize, width: u32, height: u32, cursor: &CursorPosition, size: &ImageSize) -> TerminalRect {
+        match *size {
+            ImageSize::ShrinkIfNeeded => self.fit_image_to_rect(dimensions, width, height, cursor),
+            ImageSize::Specific(columns, rows) => TerminalRect { columns, rows },
+            ImageSize::WidthScaled { ratio } => {
+                let extra_columns = (dimensions.columns as f64 * (1.0 - ratio)).ceil() as u16;
+                let scale_size = dimensions.shrink_columns(extra_columns);
+                self.scale_image(&scale_size, dimensions, width, height, cursor)
+            }
+        }
+    }
+}
+
+pub(crate) struct Surface<'a, T: TerminalIo> {
+    terminal: &'a mut T,
+    scaler: &'a dyn ScaleImage,
+}
+
+impl<'a, T: TerminalIo> Surface<'a, T> {
+    pub(crate) fn new(terminal: &'a mut T, scaler: &'a dyn ScaleImage) -> Self {
+        Self { terminal, scaler }
+    }
+}
+
+impl<T: TerminalIo> TerminalIo for Surface<'_, T> {
+    fn execute(&mut self, command: &TerminalCommand<'_>) -> Result<(), TerminalError> {
+        self.terminal.execute(command)
+    }
+
+    fn cursor_row(&self) -> u16 {
+        self.terminal.cursor_row()
+    }
+}
+
+impl<T: TerminalIo> ScaleImage for Surface<'_, T> {
+    fn scale_image(&self, scale_size: &WindowSize, window_dimensions: &WindowSize, image_width: u32, image_height: u32, position: &CursorPosition) -> TerminalRect {
+        self.scaler.scale_image(scale_size, window_dimensions, image_width, image_height, position)
+    }
+
+    fn fit_image_to_rect(&self, dimensions: &WindowSize, image_width: u32, image_height: u32, position: &CursorPosition) -> TerminalRect {
+        self.scaler.fit_image_to_rect(dimensions, image_width, image_height, position)
+    }
+}
+
+impl<T: TerminalIo> RenderSurface for Surface<'_, T> {}
