+++ b/sceptre/template_handlers/helper.py
@@ -21,6 +21,26 @@
 """
 Template handler helpers.
 """
+
+
+def prepare_template(path, user_data, environment, jinja_suffixes, python_suffixes,
+                     stream=None, raw_suffixes=()):
+    suffix = path.suffix
+    if suffix in raw_suffixes or suffix not in jinja_suffixes + python_suffixes:
+        return stream.read() if stream is not None else None, path
+
+    def render(filename):
+        if suffix in jinja_suffixes:
+            return render_jinja_template(
+                filename, {"sceptre_user_data": user_data}, environment
+            )
+        return call_sceptre_handler(filename, user_data)
+
+    if stream is None:
+        return render(str(path)), None
+    stream.seek(0)
+    stream.read()
+    return render(stream.name), None
 
 
 def call_sceptre_handler(path, sceptre_user_data):
