--- /dev/null
+++ b/sceptre/config/merge.py
@@ -0,0 +1,23 @@
+def validate_merge_inputs(parent, child, container_type):
+    for value in (parent, child):
+        if value and not isinstance(value, container_type):
+            raise TypeError("{} is not a {}".format(value, container_type.__name__))
+    return parent, child
+
+
+def merge_operands(parent, child, container_type):
+    parent, child = validate_merge_inputs(parent, child, container_type)
+    if parent is None:
+        return (child,)
+    if child is None:
+        return (parent,)
+    return parent, child
+
+
+def merge_entries(parent, child):
+    combined = {**parent, **child}
+    for key, value in combined.items():
+        if key in child:
+            yield key, value, None
+        else:
+            yield key, value, parent
