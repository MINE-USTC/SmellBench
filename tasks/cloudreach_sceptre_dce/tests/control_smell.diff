diff --git a/sceptre/resolvers/argument.py b/sceptre/resolvers/argument.py
new file mode 100644
--- /dev/null
+++ b/sceptre/resolvers/argument.py
@@ -0,0 +1,21 @@
+from sceptre.helpers import _call_func_on_values
+
+
+def resolve_argument_values(argument, resolver_type, assign, evaluate=None,
+                            on_empty=None, recover=None, recover_error=()):
+    removals = []
+
+    def visit(container, key, resolver):
+        try:
+            value = evaluate(resolver) if evaluate is not None else resolver.resolve()
+            if value is None:
+                if on_empty is not None:
+                    on_empty(key)
+                removals.append((container, key))
+                return
+        except recover_error:
+            value = recover(container, key, resolver)
+        assign(container, key, value, resolver)
+
+    _call_func_on_values(visit, argument, resolver_type)
+    return removals
