@@ -0,0 +1,21 @@
+import type { GrepMode, GrepRow } from "./grepResults";
+
+export function contentWriter(mode: GrepMode, pending: GrepRow[]): { flush(): void; lines: string[] } | undefined {
+  if (mode !== "content") return undefined;
+  const lines: string[] = [];
+  let lastPath: string | undefined;
+  return {
+    lines,
+    flush() {
+      for (const row of pending) {
+        if (row.path !== lastPath) {
+          if (lastPath !== undefined) lines.push("");
+          lines.push(row.path);
+          lastPath = row.path;
+        }
+        lines.push(`${row.line}${row.match ? ":" : "-"}${row.text}`);
+      }
+      pending.length = 0;
+    },
+  };
+}
diff --git a/src/agent/tools/grepProtocol.ts b/src/agent/tools/grepProtocol.ts
new file mode 100644
index 0000000..f7a6d13
--- /dev/null
+++ b/src/agent/tools/grepProtocol.ts
@@ -0,0 +1,45 @@
+import type { GrepMode, GrepRow } from "./grepResults";
+
+type Encoded = { text?: string; bytes?: string };
+export interface SearchEvent {
+  type: string;
+  data: { path?: Encoded; lines?: Encoded; line_number?: number };
+}
+const decode = (value?: Encoded) => value?.text ?? (value?.bytes ? Buffer.from(value.bytes, "base64").toString("utf8") : "");
+
+export interface SearchCursor {
+  path: string;
+  lastRow: number;
+  lastMatch: number;
+  matchingLines: number;
+  markedFile: boolean;
+}
+
+export function metadataReceiver(mode: GrepMode, cursor: SearchCursor, relative: (file: string) => string, push: (row: GrepRow) => boolean, stop: () => void): ((event: SearchEvent) => boolean) {
+  return event => {
+    if (event.type === "begin") {
+      cursor.path = relative(decode(event.data.path));
+      cursor.lastRow = 0;
+      cursor.lastMatch = 0;
+      cursor.matchingLines = 0;
+      cursor.markedFile = false;
+      return true;
+    }
+    if (mode === "content") return false;
+    if (event.type === "match" || event.type === "context") {
+      const path = relative(decode(event.data.path));
+      const lines = decode(event.data.lines).replace(/\r?\n$/, "").split(/\r?\n/);
+      for (let i = 0; i < lines.length; i++) {
+        const number = Number(event.data.line_number) + i;
+        if (event.type === "match" && number > cursor.lastMatch) { cursor.matchingLines++; cursor.lastMatch = number; }
+        if (mode === "files_with_matches" && event.type === "match" && !cursor.markedFile) {
+          cursor.markedFile = true;
+          if (!push({ path })) { stop(); return true; }
+        }
+      }
+    } else if (event.type === "end" && mode === "count" && cursor.matchingLines > 0) {
+      if (!push({ path: cursor.path, count: cursor.matchingLines })) stop();
+    }
+    return true;
+  };
+}
