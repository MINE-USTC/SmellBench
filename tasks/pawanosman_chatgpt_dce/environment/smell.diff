diff --git a/src/agent/tools/grepWindows.ts b/src/agent/tools/grepWindows.ts
new file mode 100644
index 0000000..5d760b0
--- /dev/null
+++ b/src/agent/tools/grepWindows.ts
@@ -0,0 +1,16 @@
+import type { GrepMode, GrepRow } from "./grepResults";
+
+export function consumeWindows(mode: GrepMode, file: string, lines: string[], matches: Set<number>, before: number, after: number, push: (row: GrepRow) => boolean): { through: number; full: boolean } {
+  if (mode !== "content") return { through: -1, full: false };
+  let through = -1;
+  for (const match of matches) {
+    const end = Math.min(lines.length - 1, match + after);
+    let line = Math.max(through + 1, match - before, 0);
+    while (line <= end) {
+      if (!push({ path: file, line: line + 1, text: lines[line], match: matches.has(line) })) return { through: line - 1, full: true };
+      line++;
+    }
+    through = Math.max(through, end);
+  }
+  return { through, full: false };
+}
