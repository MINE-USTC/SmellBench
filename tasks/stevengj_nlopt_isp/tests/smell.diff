index 0000000..d647d33
--- /dev/null
+++ b/src/util/callback-service.h
@@ -0,0 +1,152 @@
+#ifndef NLOPT_CALLBACK_SERVICE_H
+#define NLOPT_CALLBACK_SERVICE_H
+
+typedef struct {
+    nlopt_func scalar;
+    nlopt_mfunc vector;
+    nlopt_precond precondition;
+    void *data;
+    unsigned count;
+    nlopt_munge destroy;
+    nlopt_munge copy;
+    unsigned input_dimension;
+    const double *input_lb, *input_ub;
+    double *input_point, *input_gradient;
+    int owns_input;
+    int negate;
+    const double *feasible_lb, *feasible_ub;
+    double *best_value, *best_point;
+    int *evaluations;
+    int count_before;
+    const double *multipliers;
+    double penalty;
+    double *opposite;
+    const int *force_stop;
+    const double *input_scale;
+} nlopt_callback_service;
+
+static nlopt_callback_service nlopt_callback_bind(nlopt_func scalar,
+    nlopt_mfunc vector, nlopt_precond precondition, void *data,
+    unsigned count, nlopt_munge destroy, nlopt_munge copy)
+{
+    nlopt_callback_service s;
+    s.scalar = scalar;
+    s.vector = vector;
+    s.precondition = precondition;
+    s.data = data;
+    s.count = count;
+    s.destroy = destroy;
+    s.copy = copy;
+    s.input_dimension = 0;
+    s.input_lb = s.input_ub = NULL;
+    s.input_point = s.input_gradient = NULL;
+    s.owns_input = s.negate = 0;
+    s.feasible_lb = s.feasible_ub = NULL;
+    s.best_value = s.best_point = NULL;
+    s.evaluations = NULL;
+    s.count_before = 0;
+    s.multipliers = NULL;
+    s.penalty = 1;
+    s.opposite = NULL;
+    s.force_stop = NULL;
+    s.input_scale = NULL;
+    return s;
+}
+
+static void nlopt_callback_evaluate(const nlopt_callback_service *s,
+    double *result, unsigned n, const double *x, double *gradient)
+{
+    unsigned i, j, callback_n = n;
+    const double *callback_x = x;
+    double *callback_gradient = gradient;
+    if (s->evaluations && s->count_before)
+        ++*s->evaluations;
+    if (s->input_point) {
+        callback_n = s->input_dimension;
+        for (i = j = 0; i < callback_n; ++i) {
+            if (s->input_scale) {
+                double v = x[i];
+                if (v < s->input_lb[i]) v = s->input_lb[i];
+                else if (v > s->input_ub[i]) v = s->input_ub[i];
+                s->input_point[i] = v * s->input_scale[i];
+            } else {
+                s->input_point[i] = s->input_lb[i] == s->input_ub[i]
+                    ? s->input_lb[i] : x[j++];
+            }
+        }
+        callback_x = s->input_point;
+        callback_gradient = gradient ? s->input_gradient : NULL;
+    }
+    if (s->scalar)
+        result[0] = s->scalar(callback_n, callback_x, callback_gradient, s->data);
+    else
+        s->vector(s->count, result, callback_n, callback_x, callback_gradient, s->data);
+    if (s->evaluations && !s->count_before)
+        ++*s->evaluations;
+    if (s->force_stop && *s->force_stop)
+        return;
+    if (gradient && s->input_point)
+        for (i = j = 0; i < callback_n; ++i)
+            if (s->input_lb[i] != s->input_ub[i])
+                gradient[j++] = s->input_gradient[i];
+    if (s->negate) {
+        for (i = 0; i < s->count; ++i)
+            result[i] = -result[i];
+        if (gradient)
+            for (i = 0; i < n * s->count; ++i)
+                gradient[i] = -gradient[i];
+    }
+    for (i = 0; i < s->count; ++i) {
+        if (s->opposite)
+            s->opposite[i] = -result[i];
+        if (s->multipliers)
+            result[i] += s->multipliers[i] / s->penalty;
+    }
+    if (s->best_value) {
+        int feasible = 1;
+        for (i = 0; i < n; ++i) {
+            if (s->feasible_lb && x[i] < s->feasible_lb[i])
+                feasible = 0;
+            if (s->feasible_ub && x[i] > s->feasible_ub[i])
+                feasible = 0;
+        }
+        if (feasible && result[0] < *s->best_value) {
+            *s->best_value = result[0];
+            for (i = 0; i < n; ++i)
+                s->best_point[i] = x[i];
+        }
+    }
+}
+
+static void nlopt_callback_precondition(const nlopt_callback_service *s,
+    unsigned n, const double *x, const double *v, double *vpre)
+{
+    unsigned i;
+    s->precondition(n, x, v, vpre, s->data);
+    if (s->negate)
+        for (i = 0; i < n; ++i)
+            vpre[i] = -vpre[i];
+}
+
+static void nlopt_callback_release_input(nlopt_callback_service *s)
+{
+    if (s->owns_input) {
+        free(s->input_point);
+        free(s->input_gradient);
+        s->input_point = s->input_gradient = NULL;
+        s->owns_input = 0;
+    }
+}
+
+static void *nlopt_callback_copy(const nlopt_callback_service *s)
+{
+    return s->copy && s->data ? s->copy(s->data) : s->data;
+}
+
+static void nlopt_callback_destroy(const nlopt_callback_service *s)
+{
+    if (s->destroy)
+        s->destroy(s->data);
+}
+
+#endif
