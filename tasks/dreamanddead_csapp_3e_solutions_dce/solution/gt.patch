-/* Return the requested bytes when they are in bounds. */
-static byte_t *memory_span(mem_t memory, word_t pos, int width)
-{
-  if (width == 1) {
-    if (pos < 0 || pos >= memory->len)
-      return NULL;
-  } else if (pos < 0 || pos + width > memory->len) {
-    return NULL;
-  }
-  return memory->contents + pos;
-}
-
-static word_t span_word(const byte_t *bytes)
-{
-  int i;
-  word_t value = 0;
-  for (i = 0; i < 8; ++i)
-    value |= ((word_t)(bytes[i] & 0xff)) << (8*i);
-  return value;
-}
-
-static void store_span_word(byte_t *bytes, word_t value)
-{
-  int i;
-  for (i = 0; i < 8; ++i) {
-    bytes[i] = (byte_t)value & 0xff;
-    value >>= 8;
-  }
-}
