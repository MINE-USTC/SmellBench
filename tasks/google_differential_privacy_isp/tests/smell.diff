diff --git a/go/dpagg/backend.go b/go/dpagg/backend.go
new file mode 100644
index 0000000..632477e
--- /dev/null
+++ b/go/dpagg/backend.go
@@ -0,0 +1,164 @@
+package dpagg
+
+import (
+	"fmt"
+	"github.com/google/differential-privacy/go/v4/checks"
+	"github.com/google/differential-privacy/go/v4/noise"
+	"github.com/google/differential-privacy/go/v4/rand"
+)
+
+type aggregationBackend interface {
+	noise.Noise
+	Encode(interface{}, *aggregationState) ([]byte, error)
+	Decode(interface{}, []byte) error
+	SampleInt64(int64, int64, int64, float64, float64, *aggregationState) (int64, error)
+	SampleFloat64(float64, int64, float64, float64, float64, *aggregationState) (float64, error)
+	Kind() noise.Kind
+	Restore(noise.Kind) noise.Noise
+	ClampInt64(int64, int64, int64) (int64, error)
+	ClampFloat64(float64, float64, float64) (float64, error)
+	CachedCount(map[int]int64, map[int]float64, int, int64, float64, float64, float64) (float64, bool, error)
+	PartitionProbability(int64, int64, float64, float64) (float64, error)
+	Uniform() float64
+	DefaultNoise() noise.Noise
+	NewCount(*CountOptions) (*Count, error)
+	NewSum(*BoundedSumFloat64Options) (*BoundedSumFloat64, error)
+	IntBounds(int64, int64) error
+	FloatBounds(float64, float64) (bool, error)
+	PartitionCount(int64, float64, float64) (*Count, float64, error)
+	CountValue(*Count) (int64, bool, error)
+	SumValue(*BoundedSumFloat64) (float64, bool, error)
+}
+
+type nativeAggregationBackend struct {
+	noise.Noise
+}
+
+func backend(n noise.Noise) aggregationBackend {
+	return nativeAggregationBackend{Noise: n}
+}
+
+func (b nativeAggregationBackend) Encode(v interface{}, state *aggregationState) ([]byte, error) {
+	switch record := v.(type) {
+	case encodableCount:
+		record.NoiseKind = b.Kind()
+		v = record
+	case encodableBoundedSumInt64:
+		record.NoiseKind = b.Kind()
+		v = record
+	case encodableBoundedSumFloat64:
+		record.NoiseKind = b.Kind()
+		v = record
+	case encodableBoundedQuantiles:
+		record.NoiseKind = b.Kind()
+		v = record
+	}
+	*state = serialized
+	return encode(v)
+}
+
+func (b nativeAggregationBackend) SampleInt64(v, l0, lInf int64, epsilon, delta float64, state *aggregationState) (int64, error) {
+	*state = resultReturned
+	return b.AddNoiseInt64(v, l0, lInf, epsilon, delta)
+}
+
+func (b nativeAggregationBackend) SampleFloat64(v float64, l0 int64, lInf, epsilon, delta float64, state *aggregationState) (float64, error) {
+	*state = resultReturned
+	return b.AddNoiseFloat64(v, l0, lInf, epsilon, delta)
+}
+
+func (b nativeAggregationBackend) Decode(v interface{}, data []byte) error {
+	return decode(v, data)
+}
+
+func (b nativeAggregationBackend) Kind() noise.Kind {
+	return noise.ToKind(b.Noise)
+}
+
+func (b nativeAggregationBackend) Restore(k noise.Kind) noise.Noise {
+	return noise.ToNoise(k)
+}
+
+func (b nativeAggregationBackend) ClampInt64(v, lower, upper int64) (int64, error) {
+	return ClampInt64(v, lower, upper)
+}
+
+func (b nativeAggregationBackend) ClampFloat64(v, lower, upper float64) (float64, error) {
+	return ClampFloat64(v, lower, upper)
+}
+
+func (b nativeAggregationBackend) CachedCount(tree map[int]int64, cache map[int]float64, index int, l0 int64, lInf, epsilon, delta float64) (float64, bool, error) {
+	if value, ok := cache[index]; ok {
+		return value, false, nil
+	}
+	value, err := b.AddNoiseFloat64(float64(tree[index]), l0, lInf, epsilon, delta)
+	if err != nil {
+		return 0, false, err
+	}
+	return value, true, nil
+}
+
+func (b nativeAggregationBackend) PartitionProbability(count, l0 int64, epsilon, delta float64) (float64, error) {
+	return keepPartitionProbability(count, l0, epsilon, delta)
+}
+
+func (b nativeAggregationBackend) Uniform() float64 {
+	return rand.Uniform()
+}
+
+func (b nativeAggregationBackend) DefaultNoise() noise.Noise {
+	if b.Noise == nil {
+		return noise.Laplace()
+	}
+	return b.Noise
+}
+
+func (b nativeAggregationBackend) NewCount(options *CountOptions) (*Count, error) {
+	configured := *options
+	configured.Noise = b.Noise
+	return NewCount(&configured)
+}
+
+func (b nativeAggregationBackend) NewSum(options *BoundedSumFloat64Options) (*BoundedSumFloat64, error) {
+	configured := *options
+	configured.Noise = b.Noise
+	return NewBoundedSumFloat64(&configured)
+}
+
+func (b nativeAggregationBackend) IntBounds(lower, upper int64) error {
+	if b.Kind() == noise.Unrecognised {
+		return checks.CheckBoundsInt64IgnoreOverflows(lower, upper)
+	}
+	return checks.CheckBoundsInt64(lower, upper)
+}
+
+func (b nativeAggregationBackend) FloatBounds(lower, upper float64) (bool, error) {
+	if b.Kind() == noise.Unrecognised {
+		return false, checks.CheckBoundsFloat64IgnoreOverflows(lower, upper)
+	}
+	return true, checks.CheckBoundsFloat64(lower, upper)
+}
+
+func (b nativeAggregationBackend) PartitionCount(l0 int64, epsilon, delta float64) (*Count, float64, error) {
+	thresholdDelta := delta / 2
+	count, err := b.NewCount(&CountOptions{
+		Epsilon: epsilon, Delta: thresholdDelta, MaxPartitionsContributed: l0,
+	})
+	return count, thresholdDelta, err
+}
+
+func (b nativeAggregationBackend) CountValue(c *Count) (int64, bool, error) {
+	if c.state != defaultState {
+		return 0, false, fmt.Errorf("Count's noised result cannot be computed: %s", c.state.errorMessage())
+	}
+	value, err := backend(c.Noise).SampleInt64(c.count, c.l0Sensitivity, c.lInfSensitivity, c.epsilon, c.delta, &c.state)
+	return value, true, err
+}
+
+func (b nativeAggregationBackend) SumValue(s *BoundedSumFloat64) (float64, bool, error) {
+	if s.state != defaultState {
+		return 0, false, fmt.Errorf("BoundedSumFloat64's noised result cannot be computed: %s", s.state.errorMessage())
+	}
+	value, err := backend(s.Noise).SampleFloat64(s.sum, s.l0Sensitivity, s.lInfSensitivity, s.epsilon, s.delta, &s.state)
+	return value, true, err
+}
