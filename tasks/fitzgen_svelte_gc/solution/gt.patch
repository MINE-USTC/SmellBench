-}
-fn collect_monomorphizations(&mut self, items: &ir::Items, opts: &opt::Monos) -> anyhow::Result<()> {
-    let regexps = regex::RegexSet::new(opts.functions())?;
-    let mut positions = BTreeMap::new();
-    let mut instances = BTreeSet::new();
-    for item in items.iter() {
-        let generic = match item.monomorphization_of() { Some(name) => name, None => continue };
-        if !opts.functions().is_empty() {
-            if opts.using_regexps() {
-                if !regexps.is_match(generic) { continue; }
-            } else if !opts.functions().iter().any(|name| name == generic) { continue; }
-        }
-        if !instances.insert((generic, item.name(), item.size())) { continue; }
-        let position = *positions.entry(generic).or_insert_with(|| {
-            let position = self.monos.len();
-            self.monos.push(MonosEntry { name: generic.to_string(), insts: vec![], size: 0, bloat: 0 });
-            position
-        });
-        let entry = &mut self.monos[position];
-        entry.size += item.size();
-        entry.insts.push((item.name().to_string(), item.size()));
-        let largest = self.largest_instances.entry(generic.to_string()).or_insert(0);
-        *largest = cmp::max(*largest, item.size());
-    }
-    Ok(())
