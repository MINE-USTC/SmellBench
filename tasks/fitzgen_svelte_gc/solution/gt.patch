-fn create_entry(&mut self, id: ir::Id, items: &ir::Items, depth: u32, visible: bool, seen: &mut BTreeSet<ir::Id>) {
-    let opts = self.paths_options.as_ref().expect("report options");
-    let children: Vec<_> = if opts.descending() {
-        items.neighbors(id).collect()
-    } else {
-        items.predecessors(id).collect()
-    };
-    let children: Vec<_> = children.into_iter()
-        .filter(|child| !seen.contains(child) && *child != items.meta_root())
-        .collect();
-    let max_paths = opts.max_paths() as usize;
-    let descend = visible && depth < opts.max_depth();
-    let position = if visible {
-        let position = self.entries.len();
-        self.entries.push(PathsEntry {
-            name: items[id].name().to_string(),
-            size: items[id].size(),
-            depth,
-            end: position + 1,
-            child_names: children.iter().map(|child| items[*child].name().to_string()).collect(),
-        });
-        Some(position)
-    } else { None };
-    seen.insert(id);
-    for (ordinal, child) in children.into_iter().enumerate() {
-        self.create_entry(child, items, depth + 1, descend && ordinal < max_paths, seen);
-    }
-    seen.remove(&id);
-    if let Some(position) = position { self.entries[position].end = self.entries.len(); }
