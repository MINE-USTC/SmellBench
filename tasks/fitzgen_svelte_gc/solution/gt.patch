-pub(crate) fn monos(items: &mut ir::Items, opts: &opt::Monos) -> anyhow::Result<Box<dyn traits::Emit>> {
-        let mut report = AnalysisEngine::default();
-        report.collect_monomorphizations(items, opts)?;
-        let mut rows = std::mem::take(&mut report.monos);
-        for entry in &mut rows {
-            entry.insts.sort_by(|(a_name,a_size),(b_name,b_size)| b_size.cmp(a_size).then(a_name.cmp(b_name)));
-            let count = entry.insts.len() as u32;
-            let largest = report.largest_instances.remove(&entry.name).expect("collected generic");
-            entry.bloat = cmp::min((entry.size/count)*(count-1), entry.size-largest);
-            if opts.only_generics() { entry.insts.clear(); } else {
-                let max = opts.max_monos() as usize;
-                let mut bytes = 0u32;
-                let mut omitted = 0u32;
-                for (_,size) in entry.insts.iter().skip(max) { bytes += size; omitted += 1; }
-                entry.insts.truncate(max);
-                if omitted > 0 { entry.insts.push((format!("... and {} more.",omitted),bytes)); }
-            }
-        }
-        rows.sort();
-        let max=opts.max_generics() as usize;
-        let (mut count,mut bytes,mut savings)=(0usize,0u32,0u32);
-        let (mut rest_count,mut rest_bytes,mut rest_savings)=(0usize,0u32,0u32);
-        for (position,entry) in rows.iter().enumerate() {
-            let row_count=1+entry.insts.len();
-            count+=row_count;bytes+=entry.size;savings+=entry.bloat;
-            if position>=max {rest_count+=row_count;rest_bytes+=entry.size;rest_savings+=entry.bloat;}
-        }
-        let has_remaining=rows.len()>max;
-        rows.truncate(max);
-        if has_remaining {rows.push(MonosEntry{name:format!("... and {} more.",rest_count),size:rest_bytes,insts:vec![],bloat:rest_savings});}
