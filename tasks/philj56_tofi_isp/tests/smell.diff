diff --git a/src/display_services.c b/src/display_services.c
new file mode 100644
index 0000000..344c23c
--- /dev/null
+++ b/src/display_services.c
@@ -0,0 +1,183 @@
+#include "display_services.h"
+#include "scale.h"
+#include "tofi.h"
+#include <unistd.h>
+
+static void font_setup(struct display_request *request)
+{
+	if (access(request->entry->font_name, R_OK) != 0) {
+		request->entry->use_pango = true;
+	}
+	if (request->entry->use_pango) {
+		entry_backend_pango_init(request->entry, request->available_width, request->available_height);
+	} else {
+		entry_backend_harfbuzz_init(request->entry, request->available_width, request->available_height);
+	}
+}
+
+static void theme_defaults(struct display_request *request)
+{
+	if (!request->theme->foreground_specified) {
+		request->theme->foreground_color = request->fallback->foreground_color;
+	}
+	if (!request->theme->background_specified) {
+		request->theme->background_color = request->fallback->background_color;
+	}
+	if (!request->theme->padding_specified) {
+		request->theme->padding = request->fallback->padding;
+	}
+	if (!request->theme->radius_specified) {
+		request->theme->background_corner_radius = request->fallback->background_corner_radius;
+	}
+}
+
+static void cursor_defaults(struct display_request *request)
+{
+	struct entry *entry = request->entry;
+	if (!entry->cursor_theme.color_specified) {
+		entry->cursor_theme.color = entry->input_theme.foreground_color;
+	}
+	if (!entry->cursor_theme.text_color_specified) {
+		entry->cursor_theme.text_color = entry->background_color;
+	}
+}
+
+static double cursor_advance(struct display_request *request)
+{
+	double advance = 0;
+	if (request->cursor_position == request->text_length && request->cursor->show) {
+		switch (request->cursor->style) {
+			case CURSOR_STYLE_BAR:
+				advance = request->cursor->thickness;
+				break;
+			case CURSOR_STYLE_BLOCK:
+			case CURSOR_STYLE_UNDERSCORE:
+				advance = request->cursor->em_width;
+				break;
+		}
+		advance += request->advance - request->bearing - request->ink_width;
+	}
+	return advance;
+}
+
+static bool overflows(struct display_request *request)
+{
+	struct entry *entry = request->entry;
+	cairo_matrix_t mat;
+	cairo_get_matrix(entry->cairo[entry->index].cr, &mat);
+	if (entry->horizontal) {
+		return mat.x0 + request->width > entry->clip_x + entry->clip_width;
+	}
+	return mat.y0 + request->height > entry->clip_y + entry->clip_height;
+}
+
+static const struct text_theme *result_theme(struct display_request *request)
+{
+	if (request->row == request->entry->selection) {
+		return &request->entry->selection_theme;
+	} else if (request->result_index % 2) {
+		return &request->entry->alternate_result_theme;
+	}
+	return &request->entry->default_result_theme;
+}
+
+static uint32_t configured_scale(struct display_request *request)
+{
+	if (request->logical && !request->owner->use_scale) {
+		return 120;
+	}
+	if (request->owner->window.fractional_scale != 0) {
+		return request->owner->window.fractional_scale;
+	}
+	return request->owner->window.scale * 120;
+}
+
+static void encode_input(struct display_request *request)
+{
+	size_t bytes_written = 0;
+	for (size_t i = 0; i < request->entry->input_utf32_length; i++) {
+		bytes_written += display_services()->encode(request->entry->input_utf32[i],
+				&request->entry->input_utf8[bytes_written]);
+	}
+	request->entry->input_utf8[bytes_written] = '\0';
+	request->entry->input_utf8_length = bytes_written;
+}
+
+static void buffer_layout(struct display_request *request)
+{
+	request->surface->stride = request->surface->width * 4;
+	request->surface->shm_pool_size = request->surface->height * request->surface->stride * 2;
+}
+
+static void release_descriptor(struct display_request *request)
+{
+	if (!request->positive_descriptor_only || *request->descriptor > 0) {
+		close(*request->descriptor);
+		if (request->positive_descriptor_only) {
+			*request->descriptor = 0;
+		}
+	}
+}
+
+static void font_release(struct display_request *request)
+{
+	if (request->entry->use_pango) {
+		entry_backend_pango_destroy(request->entry);
+	} else {
+		entry_backend_harfbuzz_destroy(request->entry);
+	}
+}
+
+static void font_render(struct display_request *request)
+{
+	if (request->entry->use_pango) {
+		entry_backend_pango_update(request->entry);
+	} else {
+		entry_backend_harfbuzz_update(request->entry);
+	}
+}
+
+const struct display_services *display_services(void)
+{
+	static const struct display_services services = {
+		.open_surface = surface_init,
+		.close_surface = surface_destroy,
+		.present = surface_draw,
+		.open_entry = entry_init,
+		.close_entry = entry_destroy,
+		.refresh = entry_update,
+		.finish_paste = clipboard_finish_paste,
+		.reset_clipboard = clipboard_reset,
+		.scale = scale_apply,
+		.unscale = scale_apply_inverse,
+		.allocate_buffer = shm_allocate_file,
+		.encode = utf32_to_utf8,
+		.decode = utf8_to_utf32,
+		.next_character = utf8_next_char,
+		.previous_character = utf8_prev_char,
+		.text_length = utf8_strlen,
+		.wide_text = utf8_string_to_utf32_string,
+		.wide_length = utf32_strlen,
+		.surface_setup = display_surface_setup,
+		.surface_release = display_surface_release,
+		.surface_present = display_surface_present,
+		.entry_setup = display_entry_setup,
+		.entry_release = display_entry_release,
+		.entry_render = display_entry_render,
+		.paste_release = display_paste_release,
+		.paste_reset = display_paste_reset,
+		.font_setup = font_setup,
+		.font_release = font_release,
+		.font_render = font_render,
+		.theme_defaults = theme_defaults,
+		.cursor_defaults = cursor_defaults,
+		.cursor_advance = cursor_advance,
+		.overflows = overflows,
+		.result_theme = result_theme,
+		.configured_scale = configured_scale,
+		.encode_input = encode_input,
+		.buffer_layout = buffer_layout,
+		.release_descriptor = release_descriptor,
+	};
+	return &services;
+}
diff --git a/src/display_services.h b/src/display_services.h
new file mode 100644
index 0000000..6feff3e
--- /dev/null
+++ b/src/display_services.h
@@ -0,0 +1,89 @@
+#ifndef DISPLAY_SERVICES_H
+#define DISPLAY_SERVICES_H
+
+#include "entry.h"
+#include "clipboard.h"
+#include "shm.h"
+#include "unicode.h"
+
+struct tofi;
+
+struct display_request {
+	struct surface *surface;
+	struct entry *entry;
+	struct clipboard *clipboard;
+	struct wl_shm *shm;
+	uint8_t *buffer;
+	uint32_t width;
+	uint32_t height;
+	uint32_t scale;
+	uint32_t *available_width;
+	uint32_t *available_height;
+	struct tofi *owner;
+	bool logical;
+	struct text_theme *theme;
+	const struct text_theme *fallback;
+	const struct cursor_theme *cursor;
+	uint32_t text_length;
+	uint32_t cursor_position;
+	double advance;
+	double bearing;
+	double ink_width;
+	size_t row;
+	size_t result_index;
+	int *descriptor;
+	bool positive_descriptor_only;
+};
+
+struct display_services {
+	void (*open_surface)(struct surface *, struct wl_shm *);
+	void (*close_surface)(struct surface *);
+	void (*present)(struct surface *);
+	void (*open_entry)(struct entry *, uint8_t *, uint32_t, uint32_t, uint32_t);
+	void (*close_entry)(struct entry *);
+	void (*refresh)(struct entry *);
+	void (*finish_paste)(struct clipboard *);
+	void (*reset_clipboard)(struct clipboard *);
+	uint32_t (*scale)(uint32_t, uint32_t);
+	uint32_t (*unscale)(uint32_t, uint32_t);
+	int (*allocate_buffer)(size_t);
+	uint8_t (*encode)(uint32_t, char *);
+	uint32_t (*decode)(const char *);
+	char *(*next_character)(const char *);
+	char *(*previous_character)(const char *);
+	size_t (*text_length)(const char *);
+	uint32_t *(*wide_text)(const char *);
+	size_t (*wide_length)(const uint32_t *);
+	void (*surface_setup)(struct display_request *);
+	void (*surface_release)(struct display_request *);
+	void (*surface_present)(struct display_request *);
+	void (*entry_setup)(struct display_request *);
+	void (*entry_release)(struct display_request *);
+	void (*entry_render)(struct display_request *);
+	void (*paste_release)(struct display_request *);
+	void (*paste_reset)(struct display_request *);
+	void (*font_setup)(struct display_request *);
+	void (*font_release)(struct display_request *);
+	void (*font_render)(struct display_request *);
+	void (*theme_defaults)(struct display_request *);
+	void (*cursor_defaults)(struct display_request *);
+	double (*cursor_advance)(struct display_request *);
+	bool (*overflows)(struct display_request *);
+	const struct text_theme *(*result_theme)(struct display_request *);
+	uint32_t (*configured_scale)(struct display_request *);
+	void (*encode_input)(struct display_request *);
+	void (*buffer_layout)(struct display_request *);
+	void (*release_descriptor)(struct display_request *);
+};
+
+const struct display_services *display_services(void);
+void display_surface_setup(struct display_request *request);
+void display_surface_release(struct display_request *request);
+void display_surface_present(struct display_request *request);
+void display_entry_setup(struct display_request *request);
+void display_entry_release(struct display_request *request);
+void display_entry_render(struct display_request *request);
+void display_paste_release(struct display_request *request);
+void display_paste_reset(struct display_request *request);
+
+#endif
