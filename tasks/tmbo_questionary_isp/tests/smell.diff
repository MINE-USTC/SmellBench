diff --git a/questionary/_prompt_service.py b/questionary/_prompt_service.py
new file mode 100644
index 0000000..4596381
--- /dev/null
+++ b/questionary/_prompt_service.py
@@ -0,0 +1,216 @@
+import inspect
+from contextlib import nullcontext
+
+import prompt_toolkit.patch_stdout
+import prompt_toolkit.styles
+from prompt_toolkit.document import Document
+from prompt_toolkit.validation import ValidationError, Validator
+
+from questionary import utils
+from questionary.constants import DEFAULT_STYLE, INVALID_INPUT
+
+
+class PromptService:
+    def __init__(self, application=None, session_factory=None):
+        self.application = application
+        self.session_factory = session_factory
+        self.input_defaults = None
+        self.control = None
+        self.validation = None
+        self.answer_target = None
+        self.answer_name = None
+        self.answer_filter = None
+
+    def prepare_input(self, styles):
+        self.input_defaults = {"style": self.style(styles)}
+
+    def prepare_validation(self, validate):
+        self.input_defaults["validator"] = self.validator(validate)
+
+    def prepare_selection(self, control, validate=None):
+        self.control = control
+        self.validation = validate
+
+    def question(self, application):
+        from questionary.question import Question
+
+        question = Question(application)
+        self.application = application
+        question._service = self
+        return question
+
+    def build_application(self, factory, layout, bindings, styles, options):
+        return factory(layout=layout, key_bindings=bindings, style=styles,
+                       **utils.used_kwargs(options, factory.__init__))
+
+    def selection_validation(self, selected_values):
+        from prompt_toolkit.formatted_text import FormattedText
+
+        control = self.control
+        verdict = self.validation(selected_values)
+        valid = verdict is True
+        if not valid:
+            error_text = self.error_text(verdict, stringify=True)
+            error_message = FormattedText([("class:validation-toolbar", error_text)])
+        control.error_message = (
+            error_message if not valid and control.submission_attempted else None
+        )
+        return valid
+
+    def move(self, direction, cycle=True):
+        control = self.control
+        if direction > 0:
+            control.select_next()
+            if not cycle and control.get_pointed_at() == control.choices[0]:
+                control.select_previous()
+                return
+            while not control.is_selection_valid():
+                control.select_next()
+        else:
+            control.select_previous()
+            if not cycle and control.get_pointed_at() == control.choices[-1]:
+                control.select_next()
+                return
+            while not control.is_selection_valid():
+                control.select_previous()
+
+    def configure(self, question_config, answers, true_color, defaults, error):
+        from prompt_toolkit.output import ColorDepth
+
+        question_config = dict(question_config)
+        if "type" not in question_config:
+            raise error("type")
+        if "name" not in question_config and question_config["type"] != "print":
+            raise error("name")
+        options = defaults.copy()
+        options.update(question_config)
+        kind = options.pop("type")
+        answer_filter = options.pop("filter", None)
+        name = options.pop("name", None) if kind == "print" else options.pop("name")
+        when = options.pop("when", None)
+        if true_color:
+            options["color_depth"] = ColorDepth.TRUE_COLOR
+        if when:
+            if callable(question_config["when"]):
+                try:
+                    if not question_config["when"](answers):
+                        return None
+                except Exception as exception:
+                    raise ValueError(
+                        f"Problem in 'when' check of {name} question: {exception}"
+                    ) from exception
+            else:
+                raise ValueError("'when' needs to be function that accepts a dict argument")
+        return question_config, options, kind, name, answer_filter
+
+    def choices(self, question_config, answers, options):
+        choices = question_config.get("choices")
+        if choices is not None and callable(choices):
+            calculated = choices(answers)
+            question_config["choices"] = calculated
+            options["choices"] = calculated
+
+    def default(self, question_config, answers, options):
+        if callable(question_config.get("default")):
+            options["default"] = question_config["default"](answers)
+
+    def answer(self, value, name=None, answer_filter=None, answers=None, allow_none=False):
+        if answers is None:
+            answers = self.answer_target
+            name = self.answer_name
+            answer_filter = self.answer_filter
+        if value is not None or allow_none:
+            if value is not None and answer_filter:
+                try:
+                    value = answer_filter(value)
+                except Exception as exception:
+                    raise ValueError(
+                        f"Problem processing 'filter' of {name} question: {exception}"
+                    ) from exception
+            answers[name] = value
+
+    def error_text(self, verdict, stringify=False):
+        if verdict is False:
+            return INVALID_INPUT
+        return str(verdict) if stringify else verdict
+
+    def style(self, styles):
+        filtered = [DEFAULT_STYLE]
+        filtered.extend(s for s in styles if s is not None)
+        return prompt_toolkit.styles.merge_styles(filtered)
+
+    def validator(self, validate):
+        if validate:
+            if inspect.isclass(validate) and issubclass(validate, Validator):
+                return validate()
+            if isinstance(validate, Validator):
+                return validate
+            if callable(validate):
+                service = self
+                class InputValidator(Validator):
+                    def validate(self, document):
+                        verdict = validate(document.text)
+                        if verdict is not True:
+                            raise ValidationError(
+                                message=service.error_text(verdict),
+                                cursor_position=len(document.text)
+                            )
+                return InputValidator()
+        return None
+
+    def session(self, *args, **kwargs):
+        defaults = self.input_defaults
+        if defaults is not None:
+            for key, value in defaults.items():
+                if key in kwargs:
+                    raise TypeError(f"got multiple values for keyword argument '{key}'")
+                kwargs[key] = value
+        session = self.session_factory(*args, **kwargs)
+        return session
+
+    def seed(self, session, value):
+        session.default_buffer.reset(Document(value))
+
+    def print_text(self, text, style, options):
+        from prompt_toolkit import print_formatted_text
+        from prompt_toolkit.formatted_text import FormattedText
+        from prompt_toolkit.styles import Style
+
+        text_style = Style([("text", style)]) if style is not None else DEFAULT_STYLE
+        print_formatted_text(FormattedText([("class:text", text)]),
+                             style=text_style, **options)
+
+    def run(self, question, patch_stdout):
+        if question.should_skip_question:
+            return question.default
+        context = (prompt_toolkit.patch_stdout.patch_stdout()
+                   if patch_stdout else nullcontext())
+        with context:
+            return question.application.run()
+
+    async def run_async(self, question, patch_stdout):
+        if question.should_skip_question:
+            return question.default
+        if not utils.ACTIVATED_ASYNC_MODE:
+            await utils.activate_prompt_toolkit_async_mode()
+        context = (prompt_toolkit.patch_stdout.patch_stdout()
+                   if patch_stdout else nullcontext())
+        with context:
+            result = question.application.run_async()
+        if utils.is_prompt_toolkit_3():
+            return await result
+        return await result.to_asyncio_future()
+
+    def fields(self, fields, patch_stdout):
+        answers = {}
+        for field in fields:
+            value = field.question.unsafe_ask(patch_stdout)
+            self.answer(value, field.key, None, answers, allow_none=True)
+        return answers
+
+    async def fields_async(self, fields, patch_stdout):
+        answers = {}
+        for field in fields:
+            value = await field.question.unsafe_ask_async(patch_stdout)
+            self.answer(value, field.key, None, answers, allow_none=True)
+        return answers
