diff --git a/sceptre/plugin_runtime.py b/sceptre/plugin_runtime.py
new file mode 100644
index 0000000..9c4abe2
--- /dev/null
+++ b/sceptre/plugin_runtime.py
@@ -0,0 +1,301 @@
+"""Plugin runtime operations."""
+
+from contextlib import contextmanager
+
+from sceptre.helpers import _call_func_on_values, delete_keys_from_containers
+
+
+class PluginRuntime:
+    def resolved_items(self, container, resolver):
+        from sceptre.resolvers import Resolver
+
+        if isinstance(container, dict):
+            entries = container.items()
+        elif isinstance(container, list):
+            entries = enumerate(container)
+        else:
+            return
+        for key, value in entries:
+            if isinstance(value, Resolver):
+                yield container, key, value, resolver(container, key, value)
+            elif isinstance(value, (dict, list)):
+                yield from self.resolved_items(value, resolver)
+
+    def replace_value(self, owner, key, value, removals):
+        if value is None:
+            removals.append((owner, key))
+        else:
+            owner[key] = value
+
+    def clone_values(self, value, clone):
+        from sceptre.resolvers import Resolver
+
+        if isinstance(value, Resolver):
+            return clone(value)
+        if isinstance(value, list):
+            return [self.clone_values(item, clone) for item in value]
+        if isinstance(value, dict):
+            return {key: self.clone_values(item, clone) for key, item in value.items()}
+        return value
+
+    def resolve_container_entry(self, value, stack, key):
+        from sceptre.resolvers import RecursiveResolve
+
+        try:
+            return self.resolve_resolver_value(value), False
+        except RecursiveResolve:
+            return self.defer_value(value, stack, key), True
+
+    def defer_value(self, value, stack, key):
+        return self.ResolveLater(stack, self.name, key, lambda: value.resolve())
+
+    def bind_hook_value(self, container, key, value, stack):
+        container[key] = clone = value.clone_for_stack(stack)
+        clone.setup()
+
+    def command_parameters(self):
+        from sceptre.exceptions import InvalidHookArgumentTypeError
+
+        command = None
+        shell = None
+        if isinstance(self.argument, dict):
+            command = self.argument.get("run")
+            shell = self.argument.get("shell")
+        else:
+            command = self.argument
+        if not isinstance(command, str) or command == "":
+            raise InvalidHookArgumentTypeError(
+                "A cmd hook requires either a string argument or an object with "
+                f"a `run` key and a string value. You gave `{self.argument!r}`."
+            )
+        if shell is not None and not isinstance(shell, str) or shell == "":
+            raise InvalidHookArgumentTypeError(
+                "A cmd hook requires a `shell` key with a non-empty string. "
+                f"You gave `{self.argument!r}`."
+            )
+        return command, shell
+
+    def scaling_parameters(self):
+        from six import string_types
+        from sceptre.exceptions import (
+            InvalidHookArgumentTypeError, InvalidHookArgumentSyntaxError,
+            InvalidHookArgumentValueError,
+        )
+
+        if not isinstance(self.argument, string_types):
+            raise InvalidHookArgumentTypeError(
+                'The argument "{0}" is the wrong type - asg_scaling_processes '
+                "hooks require arguments of type string.".format(self.argument)
+            )
+        if "::" not in str(self.argument):
+            raise InvalidHookArgumentSyntaxError(
+                'Wrong syntax for the argument "{0}" - asg_scaling_processes '
+                "hooks use:"
+                "- !asg_scaling_processes <suspend|resume>::<process-name>".format(self.argument)
+            )
+        action, processes = self.argument.split("::")
+        if action not in ["resume", "suspend"]:
+            raise InvalidHookArgumentValueError(
+                'The argument "{0}" is invalid - valid arguments for '
+                'asg_scaling_processes hooks are "resume" or "suspend".'.format(action)
+            )
+        return action + "_processes", processes
+
+    def load_template_body(self):
+        handler_type = self.handler_config.get("type")
+        handler_class = self._get_handler_of_type(handler_type)
+        handler = handler_class(
+            name=self.name,
+            arguments={key: value for key, value in self.handler_config.items() if key != "type"},
+            sceptre_user_data=self.sceptre_user_data,
+            connection_manager=self.connection_manager,
+            stack_group_config=self.stack_group_config,
+        )
+        handler.validate()
+        body = handler.handle()
+        if isinstance(body, bytes):
+            body = body.decode("utf-8")
+        if not str(body).startswith("---"):
+            body = "---\n{}".format(body)
+        return body
+
+    def _get_handler_of_type(self, handler_type):
+        from sceptre.exceptions import TemplateHandlerNotFoundError
+
+        if not self._registry:
+            self._registry = {}
+            for entry_point in self._iterate_entry_points(
+                "sceptre.template_handlers", handler_type
+            ):
+                self._registry[entry_point.name] = entry_point.load()
+        if handler_type not in self._registry:
+            raise TemplateHandlerNotFoundError(
+                'Handler of type "{0}" not found'.format(handler_type)
+            )
+        return self._registry[handler_type]
+
+    def register_yaml_constructors(self, entry_point_groups):
+        from sceptre.config import reader
+
+        self.logger.debug(
+            "Adding yaml constructors for the entry point groups {0}".format(entry_point_groups)
+        )
+
+        def constructor_factory(node_class):
+            def class_constructor(loader, node):
+                return node_class(loader.construct_object(self.resolve_node_tag(loader, node)))
+            return class_constructor
+
+        for group in entry_point_groups:
+            for entry_point in self._iterate_entry_points(group):
+                node_tag = "!" + entry_point.name
+                node_class = entry_point.load()
+                reader.yaml.SafeLoader.add_constructor(node_tag, constructor_factory(node_class))
+                self.logger.debug(
+                    "Added constructor for %s with node tag %s", str(node_class), node_tag
+                )
+
+    def _clone_container_with_resolvers(self, container, stack):
+        return self.clone_values(container, lambda value: value.clone_for_stack(stack))
+
+    def resolve_resolver_value(self, resolver):
+        from sceptre.resolvers import RecursiveResolve
+        from sceptre.resolvers.placeholders import (
+            are_placeholders_enabled,
+            create_placeholder_value,
+        )
+
+        try:
+            return resolver.resolve()
+        except RecursiveResolve:
+            raise
+        except Exception:
+            if are_placeholders_enabled():
+                value = create_placeholder_value(resolver, self.placeholder_type)
+                self.logger.debug(
+                    "Error encountered while resolving the resolver. This is allowed for the current "
+                    f"operation. Resolving it to a placeholder value instead: {value}"
+                )
+                return value
+            raise
+
+    def _resolve_argument(self):
+        keys_to_delete = []
+        for owner, key, original, result in self.resolved_items(
+            self._argument, lambda owner, key, value: value.resolve()
+        ):
+            self.replace_value(owner, key, result, keys_to_delete)
+        delete_keys_from_containers(keys_to_delete)
+        self._argument_is_resolved = True
+
+    def _recursively_setup(self):
+        from sceptre.resolvers import Resolver
+
+        self.setup()
+
+        def setup_nested(container, key, obj):
+            obj._recursively_setup()
+
+        _call_func_on_values(setup_nested, self._argument, Resolver)
+
+    def _recursively_clone(self, stack):
+        argument = self.clone_values(
+            self._argument, lambda value: value._recursively_clone(stack)
+        )
+        return type(self)(argument, stack)
+
+    def clone_for_stack(self, stack):
+        clone = self._recursively_clone(stack)
+        clone._recursively_setup()
+        return clone
+
+    @staticmethod
+    def execute_hooks(hooks):
+        from sceptre.hooks import Hook
+
+        if isinstance(hooks, list):
+            for hook in hooks:
+                if isinstance(hook, Hook):
+                    hook.run()
+
+    def validate(self):
+        from jsonschema import validate, ValidationError
+        from sceptre.exceptions import TemplateHandlerArgumentsInvalidError
+
+        try:
+            validate(instance=self.arguments, schema=self.schema())
+        except ValidationError as error:
+            raise TemplateHandlerArgumentsInvalidError(error)
+
+    def _resolve_template_path(self, template_path):
+        from os import path
+        from sceptre.helpers import normalise_path
+
+        return path.join(
+            self.stack_group_config["project_path"],
+            "templates",
+            normalise_path(template_path),
+        )
+
+    @contextmanager
+    def downloaded_template(self, path, module, content):
+        temporary = module.tempfile.NamedTemporaryFile(prefix=path.stem)
+        if module.__name__.endswith(".http"):
+            self.logger.debug("Template file saved to: %s", temporary.name)
+        with temporary as source:
+            source.write(content)
+            source.seek(0)
+            source.read()
+            yield source.name
+
+    def render_template_source(self, source, suffix, jinja_suffixes, python_suffixes, helper):
+        if suffix in jinja_suffixes:
+            return self.render_jinja_file(source, helper)
+        if suffix in python_suffixes:
+            return helper.call_sceptre_handler(source, self.sceptre_user_data)
+
+    def render_jinja_file(self, path, helper):
+        return helper.render_jinja_template(
+            path,
+            {"sceptre_user_data": self.sceptre_user_data},
+            self.stack_group_config.get("j2_environment", {}),
+        )
+
+    def _get_retry_session(
+        self, retries, backoff_factor=0.3,
+        status_forcelist=(429, 500, 502, 503, 504), session=None,
+    ):
+        from sceptre.template_handlers import http
+
+        session = session or http.requests.Session()
+        retry = http.Retry(
+            total=retries, read=retries, connect=retries,
+            backoff_factor=backoff_factor, status_forcelist=status_forcelist,
+        )
+        adapter = http.HTTPAdapter(max_retries=retry)
+        session.mount("http://", adapter)
+        session.mount("https://", adapter)
+        return session
+
+    def _get_handler_option(self, name, default):
+        from sceptre.template_handlers.http import HANDLER_OPTION_KEY
+
+        if HANDLER_OPTION_KEY in self.stack_group_config:
+            option = self.stack_group_config.get(HANDLER_OPTION_KEY)
+            if name in option:
+                return option.get(name)
+        return default
+
+    def read_s3_template(self, path):
+        self.logger.debug("Downloading file from S3: %s", path)
+        bucket = path.parts[0]
+        key = "/".join(path.parts[1:])
+        try:
+            response = self.connection_manager.call(
+                service="s3", command="get_object",
+                kwargs={"Bucket": bucket, "Key": key},
+            )
+            return response["Body"].read()
+        except Exception as error:
+            self.logger.critical(error)
+            raise error
