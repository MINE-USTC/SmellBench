new file mode 100644
index 0000000..c7fafc4
--- /dev/null
+++ b/src/_key.ts
@@ -0,0 +1,9 @@
+export function keyPath(key: string): string {
+  const query = key.indexOf("?");
+  const path = query < 0 ? key : key.slice(0, query);
+  return path.replace(/[/\\]/g, ":");
+}
+
+export function compactKey(path: string): string {
+  return path.replace(/:+/g, ":").replace(/^:|:$/g, "");
+}
diff --git a/src/_listing.ts b/src/_listing.ts
new file mode 100644
index 0000000..01b3811
--- /dev/null
+++ b/src/_listing.ts
@@ -0,0 +1,27 @@
+import { normalizeKey } from "./utils.ts";
+
+interface KeyCollector {
+  keys: string[];
+  covers(base: string): boolean;
+  add(base: string, key: string): void;
+  mask(base: string): void;
+}
+
+export function createKeyCollector(): KeyCollector {
+  let maskedMounts: string[] = [];
+  const keys: string[] = [];
+  const covers = (base: string) => maskedMounts.some((prefix) => base.startsWith(prefix));
+  return {
+    keys,
+    covers,
+    add(base, key) {
+      const fullKey = base + normalizeKey(key);
+      if (!covers(fullKey)) {
+        keys.push(fullKey);
+      }
+    },
+    mask(base) {
+      maskedMounts = [base, ...maskedMounts.filter((prefix) => !prefix.startsWith(base))];
+    },
+  };
+}
diff --git a/src/_mounts.ts b/src/_mounts.ts
new file mode 100644
index 0000000..8d084cd
--- /dev/null
+++ b/src/_mounts.ts
@@ -0,0 +1,40 @@
+import type { Driver } from "./types.ts";
+import { normalizeBaseKey } from "./utils.ts";
+
+export interface MountRegistry {
+  mounts: Record<string, Driver>;
+  mountpoints: string[];
+}
+
+export function createMountRegistry(driver: Driver): MountRegistry {
+  return { mounts: { "": driver }, mountpoints: [""] };
+}
+
+export function registerMount(registry: MountRegistry, base: string, driver: Driver): string {
+  base = normalizeBaseKey(base);
+  if (base && registry.mounts[base]) {
+    throw new Error(`already mounted at ${base}`);
+  }
+  if (base) {
+    registry.mountpoints.push(base);
+    registry.mountpoints.sort((a, b) => b.length - a.length);
+  }
+  registry.mounts[base] = driver;
+  return base;
+}
+
+export function forgetMount(registry: MountRegistry, base: string): void {
+  if (!base) {
+    return;
+  }
+  registry.mountpoints = registry.mountpoints.filter((key) => key !== base);
+  delete registry.mounts[base];
+}
+
+export function locateMount(registry: MountRegistry, key: string): { base: string; relativeKey: string; driver: Driver } | undefined {
+  for (const base of registry.mountpoints) {
+    if (key.startsWith(base)) {
+      return { base, relativeKey: key.slice(base.length), driver: registry.mounts[base]! };
+    }
+  }
+}
diff --git a/src/_tracing.ts b/src/_tracing.ts
new file mode 100644
index 0000000..61b5879
--- /dev/null
+++ b/src/_tracing.ts
@@ -0,0 +1,34 @@
+import type { TracedOperation } from "./tracing.ts";
+
+export type TracingConfig = {
+  meta?: boolean;
+  forceMeta?: boolean;
+  base?: boolean;
+  channel?: TracedOperation;
+};
+
+export function tracingOperations(): Record<TracedOperation, TracingConfig | undefined> {
+  return {
+    getItem: { meta: true },
+    getMeta: { forceMeta: true, channel: "getItem" },
+    setItem: { meta: true },
+    removeItem: { meta: true },
+    getKeys: { base: true },
+    clear: { base: true },
+    hasItem: undefined,
+    setItems: undefined,
+    getItems: undefined,
+    getItemRaw: undefined,
+    setItemRaw: undefined,
+  };
+}
+
+export function tracingRoutes(operations: Record<TracedOperation, TracingConfig | undefined>): (TracingConfig & { operation: TracedOperation; channel: TracedOperation })[] {
+  return Object.entries(operations).map(([operation, config]) => ({
+    operation: operation as TracedOperation,
+    channel: config?.channel ?? operation as TracedOperation,
+    base: config?.base,
+    meta: config?.meta,
+    forceMeta: config?.forceMeta,
+  }));
+}
