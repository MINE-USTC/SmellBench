@@ -0,0 +1,11 @@
+export function statusFields(status: number, statusText: string = ""): { status: number; statusText: string } {
+  return {
+    status: status >= 100 && status <= 599 ? status : 500,
+    statusText: statusText.replace(/[^\u0020-\u007E]/g, ""),
+  };
+}
+
+export function errorPayload(error: Error & { status: number; statusText: string }): { status: number; statusText: string; message: string } {
+  const { status, statusText, message } = error;
+  return { status, statusText, message };
+}
