new file mode 100644
index 0000000..729af47
--- /dev/null
+++ b/src/request-plan.js
@@ -0,0 +1,31 @@
+/* global module */
+'use strict';
+
+module.exports = function (type, postData, contentType, optionsAlwaysExtendParams) {
+  var encoding = 'empty';
+  if (type === 'GET') {
+    encoding = 'none';
+  } else if (postData) {
+    encoding = contentType === 'image/jpeg' ? 'image' : 'json';
+  }
+  var destination = type !== 'GET' && postData && !optionsAlwaysExtendParams ? 'postData' : 'params';
+  return {
+    encoding: encoding,
+    destination: destination,
+    prepare: function () {
+      var headers = [];
+      var payload = null;
+      if (encoding === 'image') {
+        payload = postData;
+        headers.push(['Content-Type', contentType]);
+      } else if (encoding === 'json') {
+        payload = JSON.stringify(postData);
+        headers.push(['Content-Type', 'application/json']);
+      }
+      return { headers: headers, payload: payload };
+    },
+    options: function (requestData) {
+      return { owner: requestData, key: destination, value: requestData[destination] };
+    }
+  };
+};
diff --git a/src/response-plan.js b/src/response-plan.js
new file mode 100644
index 0000000..5fc49bb
--- /dev/null
+++ b/src/response-plan.js
@@ -0,0 +1,21 @@
+/* global module */
+'use strict';
+
+module.exports = {
+  complete: function (readyState) {
+    return readyState === 4;
+  },
+  read: function (req, report) {
+    var data = null;
+    try {
+      data = req.responseText ? JSON.parse(req.responseText) : '';
+    } catch (e) {
+      report(e);
+    }
+    var status = req.status;
+    if (status >= 200 && status < 300) {
+      return { value: data, error: null };
+    }
+    return { value: null, error: req };
+  }
+};
