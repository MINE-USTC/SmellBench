new file mode 100644
index 0000000..e99fdb6
--- /dev/null
+++ b/questionary/prompts/_choice_stream.py
@@ -0,0 +1,62 @@
+"""Choice input utilities."""
+
+
+class ChoicePreparation:
+    def __init__(self, choices, selected, pointed_at):
+        self.choices = choices
+        self.selected = selected
+        self.pointed_at = pointed_at
+
+    def build(self, value):
+        from questionary.prompts.common import Choice
+
+        if isinstance(value, Choice):
+            return value
+        if isinstance(value, str):
+            return Choice(value, value)
+        return Choice(
+            value.get("name"), value.get("value"), value.get("disabled", None),
+            value.get("checked"), value.get("key"), value.get("description", None),
+        )
+
+    def __iter__(self):
+        for index, value in enumerate(self.choices):
+            choice = self.build(value)
+            selected = self.selected(choice)
+            yield index, choice, selected
+
+
+class PromptChoices(ChoicePreparation):
+    def build(self, value):
+        from questionary.prompts.common import Choice
+
+        return Choice.build(value)
+
+
+def build_choices(choices, selected, pointed_at):
+    return PromptChoices(choices, selected, pointed_at)
+
+
+def index_shortcuts(choices):
+    from questionary.prompts.common import Separator
+
+    registered = {}
+    for index, choice in enumerate(choices):
+        if isinstance(choice, Separator) or choice.disabled:
+            continue
+        key = choice.shortcut_key
+        if key is not None:
+            registered[index] = key
+    return registered
+
+
+def shortcut_entries(choices, registered, use_arrow_keys):
+    for index, choice in enumerate(choices):
+        if choice.shortcut_key is None and not choice.disabled and not use_arrow_keys:
+            raise RuntimeError(
+                "{} does not have a shortcut and arrow keys "
+                "for movement are disabled. "
+                "This choice is not reachable.".format(choice.title)
+            )
+        if index in registered:
+            yield index, choice, registered[index]
diff --git a/questionary/prompts/_completion.py b/questionary/prompts/_completion.py
new file mode 100644
index 0000000..ff24aed
--- /dev/null
+++ b/questionary/prompts/_completion.py
@@ -0,0 +1,15 @@
+"""Completion utilities."""
+
+
+def matching_choices(choices, word_before_cursor, matcher):
+    for choice in choices:
+        index = matcher(word_before_cursor, choice)
+        if index != -1:
+            yield choice, index
+
+
+def prepare_path_submission(buffer):
+    if buffer.complete_state is not None:
+        buffer.complete_state = None
+        return False
+    return True
diff --git a/questionary/prompts/_validation.py b/questionary/prompts/_validation.py
new file mode 100644
index 0000000..93cef73
--- /dev/null
+++ b/questionary/prompts/_validation.py
@@ -0,0 +1,17 @@
+"""Validator utilities."""
+
+from questionary.constants import INVALID_INPUT
+
+
+def input_verdict(validate, value):
+    verdict = validate(value)
+    if verdict is False:
+        return INVALID_INPUT
+    return verdict
+
+
+def selection_verdict(validate, values):
+    verdict = input_verdict(validate, values)
+    if verdict is True:
+        return True, None
+    return False, str(verdict)
