+package bluemonday
+
+import (
+	"golang.org/x/net/html"
+	"io"
+	"net/url"
+	"regexp"
+	"strings"
+)
+
+type sanitizerStream interface {
+	Read([]byte) (int, error)
+	Next() html.TokenType
+	Token() html.Token
+	Err() error
+	dataAttributesAllowed() bool
+	attributeRules(string) []attrPolicy
+	stylePoliciesExist(string) bool
+	styleRules(string) map[string][]stylePolicy
+	globalStyleRules(string) []stylePolicy
+	acceptAttribute(html.Attribute, []attrPolicy) bool
+	acceptStyle(string, string, []stylePolicy) bool
+	resolveScheme(*url.URL) ([]urlPolicy, bool)
+	prepareURL(string) (string, *url.URL, bool)
+	parseableURLsRequired() bool
+	relativeURLsAllowed() bool
+	URLRules(string) ([]urlPolicy, bool)
+	URLMatchers() []*regexp.Regexp
+	elementRules(string) (map[string][]attrPolicy, bool)
+	elementPatterns() map[*regexp.Regexp]map[string][]attrPolicy
+	contentSkipped(string) bool
+	noAttributeElements() map[string]struct{}
+	noAttributePatterns() []*regexp.Regexp
+	unsafeAllowed() bool
+	commentsAllowed() bool
+	spacesAdded() bool
+	linkOptions() linkOptions
+	sandboxValues() map[string]bool
+	sourceRewriter() urlRewriter
+	Write([]byte) (int, error)
+	WriteString(string) (int, error)
+}
+
+type streamBinding struct {
+	policy *Policy
+	*html.Tokenizer
+	reader io.Reader
+	writer io.Writer
+}
+
+func newSanitizerStream(p *Policy, r io.Reader, w io.Writer) sanitizerStream {
+	s := &streamBinding{policy: p, reader: r, writer: w}
+	s.Tokenizer = tokenizerFor(s)
+	return s
+}
+
+func (s *streamBinding) dataAttributesAllowed() bool             { return s.policy.allowDataAttributes }
+func (s *streamBinding) attributeRules(name string) []attrPolicy { return s.policy.globalAttrs[name] }
+func (s *streamBinding) stylePoliciesExist(element string) bool {
+	p := s.policy
+	sps, found := p.elsAndStyles[element]
+	if len(p.globalStyles) > 0 || (found && len(sps) > 0) {
+		return true
+	}
+	for matcher, rules := range p.elsMatchingAndStyles {
+		if matcher.MatchString(element) && len(rules) > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *streamBinding) styleRules(element string) map[string][]stylePolicy {
+	p := s.policy
+	rules := p.elsAndStyles[element]
+	if len(rules) == 0 {
+		rules = map[string][]stylePolicy{}
+		for matcher, policies := range p.elsMatchingAndStyles {
+			if matcher.MatchString(element) {
+				for name, values := range policies {
+					rules[name] = append(rules[name], values...)
+				}
+			}
+		}
+	}
+	return rules
+}
+func (s *streamBinding) globalStyleRules(name string) []stylePolicy {
+	return s.policy.globalStyles[name]
+}
+
+func (s *streamBinding) acceptAttribute(attr html.Attribute, local []attrPolicy) bool {
+	for pass := 0; pass < 2; pass++ {
+		if pass == 1 {
+			local = s.attributeRules(attr.Key)
+		}
+		for _, rule := range local {
+			if rule.regexp == nil || rule.regexp.MatchString(attr.Val) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (s *streamBinding) acceptStyle(name, value string, local []stylePolicy) bool {
+	for pass := 0; pass < 2; pass++ {
+		if pass == 1 {
+			local = s.globalStyleRules(name)
+		}
+		for _, rule := range local {
+			switch {
+			case rule.handler != nil:
+				if rule.handler(value) {
+					return true
+				}
+			case len(rule.enum) > 0:
+				if stringInSlice(value, rule.enum) {
+					return true
+				}
+			case rule.regexp != nil:
+				if rule.regexp.MatchString(value) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+func (s *streamBinding) resolveScheme(u *url.URL) ([]urlPolicy, bool) {
+	if rules, found := s.URLRules(u.Scheme); found {
+		return rules, true
+	}
+	for _, matcher := range s.URLMatchers() {
+		if matcher.MatchString(u.Scheme) {
+			return nil, true
+		}
+	}
+	return nil, false
+}
+func (s *streamBinding) parseableURLsRequired() bool { return s.policy.requireParseableURLs }
+func (s *streamBinding) relativeURLsAllowed() bool   { return s.policy.allowRelativeURLs }
+func (s *streamBinding) URLRules(scheme string) ([]urlPolicy, bool) {
+	rules, found := s.policy.allowURLSchemes[scheme]
+	return rules, found
+}
+func (s *streamBinding) URLMatchers() []*regexp.Regexp { return s.policy.allowURLSchemeRegexps }
+
+type linkOptions struct {
+	requireNoFollow                      bool
+	requireNoFollowFullyQualifiedLinks   bool
+	requireNoReferrer                    bool
+	requireNoReferrerFullyQualifiedLinks bool
+	addTargetBlankToFullyQualifiedLinks  bool
+	requireCrossOriginAnonymous          bool
+}
+
+func (s *streamBinding) elementRules(name string) (map[string][]attrPolicy, bool) {
+	rules, found := s.policy.elsAndAttrs[name]
+	return rules, found
+}
+func (s *streamBinding) elementPatterns() map[*regexp.Regexp]map[string][]attrPolicy {
+	return s.policy.elsMatchingAndAttrs
+}
+func (s *streamBinding) contentSkipped(name string) bool {
+	_, found := s.policy.setOfElementsToSkipContent[name]
+	return found
+}
+func (s *streamBinding) noAttributeElements() map[string]struct{} {
+	return s.policy.setOfElementsAllowedWithoutAttrs
+}
+func (s *streamBinding) noAttributePatterns() []*regexp.Regexp {
+	return s.policy.setOfElementsMatchingAllowedWithoutAttrs
+}
+func (s *streamBinding) unsafeAllowed() bool            { return s.policy.allowUnsafe }
+func (s *streamBinding) commentsAllowed() bool          { return s.policy.allowComments }
+func (s *streamBinding) spacesAdded() bool              { return s.policy.addSpaces }
+func (s *streamBinding) sandboxValues() map[string]bool { return s.policy.requireSandboxOnIFrame }
+func (s *streamBinding) sourceRewriter() urlRewriter    { return s.policy.srcRewriter }
+func (s *streamBinding) linkOptions() linkOptions {
+	p := s.policy
+	return linkOptions{p.requireNoFollow, p.requireNoFollowFullyQualifiedLinks, p.requireNoReferrer,
+		p.requireNoReferrerFullyQualifiedLinks, p.addTargetBlankToFullyQualifiedLinks, p.requireCrossOriginAnonymous}
+}
+
+func tokenizerFor(stream sanitizerStream) *html.Tokenizer { return html.NewTokenizer(stream) }
+func (s *streamBinding) Read(p []byte) (int, error)       { return s.reader.Read(p) }
+func (s *streamBinding) Write(p []byte) (int, error)      { return s.writer.Write(p) }
+func (s *streamBinding) WriteString(value string) (int, error) {
+	if writer, ok := s.writer.(stringWriterWriter); ok {
+		return writer.WriteString(value)
+	}
+	return s.Write([]byte(value))
+}
+func (s *streamBinding) prepareURL(raw string) (string, *url.URL, bool) {
+	if !s.parseableURLsRequired() {
+		return raw, nil, true
+	}
+	raw = strings.TrimSpace(raw)
+	if strings.Contains(raw, " ") || strings.Contains(raw, "\t") || strings.Contains(raw, "\n") {
+		if !strings.HasPrefix(raw, "data:") {
+			return "", nil, false
+		}
+		matched := dataURIbase64Prefix.FindString(raw)
+		if matched != "" {
+			raw = matched + strings.Replace(strings.Replace(raw[len(matched):], "\r", "", -1), "\n", "", -1)
+		}
+	}
+	parsed, err := url.Parse(raw)
+	return raw, parsed, err == nil
+}
