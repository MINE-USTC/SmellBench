diff --git a/src/util/conditionResolution.ts b/src/util/conditionResolution.ts
new file mode 100644
--- /dev/null
+++ b/src/util/conditionResolution.ts
@@ -0,0 +1,19 @@
+import type { ConditionBuilder, ResolveOptions } from '../Condition';
+import type { ISchema } from '../types';
+import type Reference from '../Reference';
+
+type ConditionSource = { refs: readonly Reference[]; fn: ConditionBuilder<any> };
+const resolvers = new WeakMap<object, (base: any, options: ResolveOptions) => any>();
+
+export function registerCondition(condition: ConditionSource) {
+  resolvers.set(condition, (base: ISchema<any>, options: ResolveOptions) => {
+    const values = condition.refs.map((ref) =>
+      ref.getValue(options?.value, options?.parent, options?.context),
+    );
+    return condition.fn(values, base, options);
+  });
+}
+
+export function conditionResolver(condition: object) {
+  return resolvers.get(condition);
+}
diff --git a/src/util/nestedValidation.ts b/src/util/nestedValidation.ts
new file mode 100644
--- /dev/null
+++ b/src/util/nestedValidation.ts
@@ -0,0 +1,49 @@
+import type { ISchema, NestedTestConfig } from '../types';
+import Reference from '../Reference';
+
+export function nestedOptions(
+  { key, index, parent, parentPath, originalParent, options }: NestedTestConfig,
+  value: unknown,
+) {
+  const slot = key ?? index;
+  if (slot == null)
+    throw TypeError('Must include `key` or `index` for nested validations');
+  const numeric = typeof slot === 'number';
+  return {
+    ...options,
+    strict: true,
+    parent,
+    value,
+    originalValue: originalParent[slot],
+    key: undefined,
+    [numeric ? 'index' : 'key']: slot,
+    path: numeric || slot.includes('.')
+      ? `${parentPath || ''}[${numeric ? slot : `"${slot}"`}]`
+      : (parentPath ? `${parentPath}.` : '') + key,
+  };
+}
+
+export function nestedTests<Slot extends string | number>(
+  slots: Iterable<Slot>,
+  schemaAt: (slot: Slot) => ISchema<any> | Reference | undefined,
+  config: Omit<NestedTestConfig, 'key' | 'index'>,
+) {
+  const keys = Array.from(slots);
+  const tests = [];
+  const positions: number[] = [];
+  const schemas: (ISchema<any> | Reference | undefined)[] = [];
+  for (const slot of keys) {
+    const schema = schemaAt(slot);
+    schemas.push(schema);
+    if (!schema || Reference.isRef(schema)) {
+      positions.push(-1);
+      continue;
+    }
+    positions.push(tests.length);
+    tests.push(schema.asNestedTest({
+      ...config,
+      ...(typeof slot === 'number' ? { index: slot } : { key: slot }),
+    }));
+  }
+  return { tests, keys, positions, schemas };
+}
diff --git a/src/util/referenceAccess.ts b/src/util/referenceAccess.ts
new file mode 100644
--- /dev/null
+++ b/src/util/referenceAccess.ts
@@ -0,0 +1,18 @@
+type Accessor = (value: any, parent: any, context: any) => any;
+const readers = new WeakMap<object, Accessor>();
+
+export function registerReference(reference: {
+  isContext: boolean;
+  isValue: boolean;
+  getter: any;
+  map?: (value: any) => any;
+}) {
+  readers.set(reference, (value, parent, context) => {
+    const source = reference.isContext ? context : reference.isValue ? value : parent;
+    return reference.getter ? reference.getter(source || {}) : source;
+  });
+}
+
+export function referenceReader(reference: object) {
+  return readers.get(reference);
+}
diff --git a/src/util/validationBatch.ts b/src/util/validationBatch.ts
new file mode 100644
--- /dev/null
+++ b/src/util/validationBatch.ts
@@ -0,0 +1,40 @@
+import type ValidationError from '../ValidationError';
+import type { TestOptions, PanicCallback, NextCallback } from './createValidation';
+
+type CallbackTest = (args: TestOptions, panic: PanicCallback, next: NextCallback) => void;
+
+export function validationBatch(
+  tests: readonly CallbackTest[],
+  args: TestOptions,
+  panic: PanicCallback,
+  next: (errors: ValidationError[]) => void,
+) {
+      let settled = false;
+      let pending = tests.length;
+      const errors: ValidationError[] = [];
+      const fail = (error: Error) => {
+        if (settled) return;
+        settled = true;
+        panic(error);
+      };
+      const finish = () => {
+        if (settled) return;
+        settled = true;
+        next(errors);
+      };
+      const entries = tests.map((test) => ({
+        test,
+        args,
+        callbacks: {
+          panic: fail,
+          next: (error?: ValidationError | ValidationError[]) => {
+          if (error) {
+            if (Array.isArray(error)) errors.push(...error);
+            else errors.push(error);
+          }
+          if (--pending <= 0) finish();
+          },
+        },
+      }));
+      return { entries, finish };
+}
