 /* Remember id, or refresh its query time when the client retries it.
  * plid stays non-zero so the reverse direction remains the server. */
+static int dns_flight_add(connection *cxt, uint16_t id, time_t sec, long usec)
+{
+    dns_flight *node;
+    int found = 0;
+
+    if (cxt == NULL || id == 0)
+        return 0;
+    for (node = cxt->flight; node != NULL; node = node->next) {
+        if (node->id != id)
+            continue;
+        node->sec = sec;
+        node->usec = usec;
+        found = 1;
+        break;
+    }
+    /* Age after a refresh so this id is young. Do not drop another
+     * id: a retry is not a new query. */
+    dns_flight_age(cxt, sec);
+    if (found) {
+        cxt->plid = id;
+        return 1;
+    }
+    if (!mem_charge(sizeof(dns_flight)))
+        return 0;
+    node = (dns_flight *) calloc(1, sizeof(dns_flight));
+    if (node == NULL) {
+        mem_refund(sizeof(dns_flight));
+        return 0;
+    }
+    node->id = id;
+    node->sec = sec;
+    node->usec = usec;
+    /* Room is made only for a new id, and only after it can be stored.
+     * The node is not on the list, so this drop cannot free it. */
+    dns_flight_make_room(cxt);
+    node->next = cxt->flight;
+    cxt->flight = node;
+    cxt->plid = id;
+    return 1;
+}
 
 /* Copy this id's query time onto the connection and drop the id. */
+static int dns_flight_take(connection *cxt, uint16_t id)
+{
+    dns_flight **prev;
+    dns_flight *node;
+
+    if (cxt == NULL || id == 0)
+        return 0;
+    prev = &cxt->flight;
+    while ((node = *prev) != NULL) {
+        if (node->id != id) {
+            prev = &node->next;
+            continue;
+        }
+        cxt->query_time = node->sec;
+        cxt->query_usec = node->usec;
+        *prev = node->next;
+        mem_refund(sizeof(*node));
+        free(node);
+        return 1;
+    }
+    return 0;
+}
 
