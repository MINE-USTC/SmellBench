+				break
+			}
+			return err
+		}
+		tag.Header.Type = rawHeader[0]
+		tag.Header.DataSize = bele.BeUint24(rawHeader[1:])
+		tag.Header.Timestamp = uint32(rawHeader[7])<<24 + bele.BeUint24(rawHeader[4:])
+		tags = append(tags, tag)
+	}
+	reader.Dispose()
+	reader.fp = nil
 
 	return f.PumpWithTags(tags, onFlvTag)
 }
