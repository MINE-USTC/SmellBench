 func Annexb2Avcc(nals []byte) ([]byte, error) {
-	// TODO(chef): 增加原地转换，不申请内存的方式。考虑原地内存不够大的情况 202206
 	var buf nazabytes.Buffer
-	buf.Grow(len(nals) + 16) // perf: start code是三字节0 0 1时，转换时每个nal会多需要一个字节，预先申请16个字节，减少后续扩容的可能性
-	err := IterateNaluAnnexb(nals, func(nal []byte) {
-		bele.BePutUint32(buf.ReserveBytes(4), uint32(len(nal)))
+	buf.Grow(len(nals) + 16)
+	if nals == nil {
+		return buf.Bytes(), nazaerrors.Wrap(base.ErrShortBuffer)
+	}
+	start, zeros := -1, 0
+	for i, value := range nals {
+		if value == 0 {
+			zeros++
+			continue
+		}
+		if value == 1 && zeros >= 2 {
+			boundary := i - zeros
+			if start >= 0 {
+				if start >= boundary {
+					return buf.Bytes(), nazaerrors.Wrap(base.ErrAvc)
+				}
+				bele.BePutUint32(buf.ReserveBytes(4), uint32(boundary-start))
+				buf.Flush(4)
+				_, _ = buf.Write(nals[start:boundary])
+			}
+			start = i + 1
+		}
+		zeros = 0
+	}
+	if start == -1 {
+		bele.BePutUint32(buf.ReserveBytes(4), uint32(len(nals)))
 		buf.Flush(4)
-		_, _ = buf.Write(nal)
-	})
-	return buf.Bytes(), err
+		_, _ = buf.Write(nals)
+		return buf.Bytes(), nazaerrors.Wrap(base.ErrAvc)
+	}
+	if start >= len(nals) {
+		return buf.Bytes(), nazaerrors.Wrap(base.ErrAvc)
+	}
+	bele.BePutUint32(buf.ReserveBytes(4), uint32(len(nals)-start))
+	buf.Flush(4)
+	_, _ = buf.Write(nals[start:])
+	return buf.Bytes(), nil
 }
 
