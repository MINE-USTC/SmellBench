 		return err
 	}
+	header := make([]byte, flvHeaderSize)
+	_, _ = reader.fp.Read(header)
+	for {
+		var tag Tag
+		rawHeader := make([]byte, TagHeaderSize)
+		_, err = io.ReadAtLeast(reader.fp, rawHeader, TagHeaderSize)
