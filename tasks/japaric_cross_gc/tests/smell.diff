+impl DockerOptions {
+
+    pub(crate) fn configure_environment(&self, command: &mut Command, dirs: &ToolchainDirectories, msg_info: &mut MessageInfo) -> Result<()> {
+        let mut warned = false;
+        for ref var in self
+            .config
+            .env_passthrough(&self.target)
+            .unwrap_or_default()
+        {
+            let key = var.split_once('=').map_or(var.as_str(), |(key, _)| key);
+            if !var.contains('=') && !warned && !key.chars().all(|c| matches!(c, 'a'..='z' | 'A'..='Z' | '_' | '0'..='9')) {
+                msg_info.warn(format_args!(
+                    "got environment variable of \"{var}\" which is not a valid environment variable name. the proper syntax is `passthrough = [\"ENVVAR=value\"]`"
+                ))?;
+                warned = true;
+            }
+            if key == "CROSS_RUNNER" {
+                eyre::bail!("CROSS_RUNNER environment variable name is reserved and cannot be pass through");
+            }
+
+            // Only specifying the environment variable name in the "-e"
+            // flag forwards the value from the parent shell
+            command.args(["-e", var]);
+        }
+
+        let runner = self.config.runner(&self.target);
+        let cross_runner = format!("CROSS_RUNNER={}", runner.unwrap_or_default());
+        command.args(["-e", &format!("CARGO_HOME={}", dirs.cargo_mount_path())])
+            .args([
+                "-e",
+                &format!("CROSS_RUST_SYSROOT={}", dirs.sysroot_mount_path()),
+            ])
+            .args(["-e", "CARGO_TARGET_DIR=/target"])
+            .args(["-e", &cross_runner]);
+        if self.command_variant.uses_zig() {
+            // otherwise, zig has a permission error trying to create the cache
+            command.args(["-e", "XDG_CACHE_HOME=/target/.zig-cache"]);
+        }
+        command.add_configuration_envvars();
+
+        if let Some(username) = id::username().wrap_err("could not get username")? {
+            command.args(["-e", &format!("USER={username}")]);
+        }
+
+        if let Ok(value) = env::var("CROSS_CONTAINER_OPTS") {
+            if env::var("DOCKER_OPTS").is_ok() {
+                msg_info.warn("using both `CROSS_CONTAINER_OPTS` and `DOCKER_OPTS`.")?;
+            }
+            command.args(&Engine::parse_opts(&value)?);
+        } else if let Ok(value) = env::var("DOCKER_OPTS") {
+            // FIXME: remove this when we deprecate DOCKER_OPTS.
+            command.args(&Engine::parse_opts(&value)?);
+        };
+
+        let (major, minor, patch) = match self.rustc_version.as_ref() {
+            Some(version) => (version.major, version.minor, version.patch),
+            // no toolchain version available, always provide the oldest
+            // compiler available. this isn't a major issue because
+            // linking with libgcc will not include symbols found in
+            // the builtins.
+            None => (1, 0, 0),
+        };
+        command.args(["-e", &format!("CROSS_RUSTC_MAJOR_VERSION={}", major)]);
+        command.args(["-e", &format!("CROSS_RUSTC_MINOR_VERSION={}", minor)]);
+        command.args(["-e", &format!("CROSS_RUSTC_PATCH_VERSION={}", patch)]);
+
+        Ok(())
+    }
+
+    pub(crate) fn configure_mounts(&self, command: &mut Command, paths: &DockerPaths, mount_cb: impl Fn(&mut Command, &Path, &Path) -> Result<()>, mut store_cb: impl FnMut((String, String)), msg_info: &mut MessageInfo) -> Result<()> {
+        let mut warned = false;
+        for ref var in self
+            .config
+            .env_volumes(&self.target)
+            .unwrap_or_default()
+        {
+            let (key, value) = var.split_once('=').map_or((var.as_str(), None), |(key, value)| (key, Some(value)));
+            if value.is_none() && !warned && !key.chars().all(|c| matches!(c, 'a'..='z' | 'A'..='Z' | '_' | '0'..='9')) {
+                msg_info.warn(format_args!(
+                    "got volume of \"{var}\" which is not a valid environment variable name. the proper syntax is `volumes = [\"ENVVAR=/path/to/directory\"]`"
+                ))?;
+                warned = true;
+            }
+            if key == "CROSS_RUNNER" {
+                eyre::bail!("CROSS_RUNNER environment variable name is reserved and cannot be pass through");
+            }
+            let var = key;
+            let value = match value {
+                Some(v) => Ok(v.to_owned()),
+                None => env::var(var),
+            };
+
+            // NOTE: we use canonical paths on the host, since it's unambiguous.
+            // however, for the mounted paths, we use the same path as was
+            // provided. this avoids canonicalizing symlinks which then causes
+            // the mounted path to differ from the path expected on the host.
+            // for example, if `/tmp` is a symlink to `/private/tmp`, canonicalizing
+            // it would lead to us mounting `/tmp/process` to `/private/tmp/process`,
+            // which would cause any code relying on `/tmp/process` to break.
+
+            if let Ok(val) = value {
+                let canonical_path = file::canonicalize(&val)?;
+                let host_path = paths.mount_finder.find_path(&canonical_path, true)?;
+                let mount_path = Path::new(&val).as_posix_absolute()?;
+                mount_cb(command, host_path.as_ref(), mount_path.as_ref())?;
+                command.args(["-e", &format!("{}={}", var, mount_path)]);
+                store_cb((val, mount_path));
+            }
+        }
+
+        for path in paths.workspace_dependencies() {
+            // NOTE: we use canonical paths here since cargo metadata
+            // always canonicalizes paths, so these should be relative
+            // to the mounted project directory.
+            let canonical_path = file::canonicalize(path)?;
+            let host_path = paths.mount_finder.find_path(&canonical_path, true)?;
+            let mount_path = path.as_posix_absolute()?;
+            mount_cb(command, host_path.as_ref(), mount_path.as_ref())?;
+            store_cb((path.to_utf8()?.to_owned(), mount_path));
+        }
+
+        Ok(())
+    }
+}
