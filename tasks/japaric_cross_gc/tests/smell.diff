+impl DockerOptions {
+    pub(crate) fn build_dockerfile(&self, dockerfile: &Dockerfile<'_>, paths: &DockerPaths, build_args: impl IntoIterator<Item = (impl AsRef<str>, impl AsRef<str>)>, msg_info: &mut MessageInfo) -> Result<String> {
+        let uses_zig = self.command_variant.uses_zig();
+        let mut docker_build = self.engine.command();
+        docker_build.invoke_build_command();
+        docker_build.disable_scan_suggest();
+        dockerfile.runs_with()
+            .specify_platform(&self.engine, &mut docker_build);
+
+        docker_build.progress(None)?;
+        docker_build.verbose(msg_info.verbosity);
+        docker_build.cross_labels(self.target.triple(), dockerfile.runs_with().target.triple());
+
+        docker_build.args([
+            "--label",
+            &format!(
+                "{}.workspace_root={}",
+                crate::CROSS_LABEL_DOMAIN,
+                paths.workspace_root().to_utf8()?
+            ),
+        ]);
+
+        let image_name = dockerfile.image_name(self.target.target(), &paths.metadata)?;
+        docker_build.args(["--tag", &image_name]);
+
+        for (key, arg) in build_args {
+            docker_build.args(["--build-arg", &format!("{}={}", key.as_ref(), arg.as_ref())]);
+        }
+
+        if let Some(arch) = self.target.target().deb_arch() {
+            docker_build.args(["--build-arg", &format!("CROSS_DEB_ARCH={arch}")]);
+        }
+
+        let path = match dockerfile {
+            Dockerfile::File { path, .. } => {
+                paths.metadata.workspace_root.join(PathBuf::from(path))
+            }
+            Dockerfile::Custom { content, .. } => {
+                let target_dir = paths
+                    .metadata
+                    .target_directory
+                    .join(self.target.to_string());
+                create_target_dir(&target_dir)?;
+                let path = target_dir.join(format!("Dockerfile.{}-custom", &self.target));
+                {
+                    let mut file = file::write_file(&path, true)?;
+                    file.write_all(content.as_bytes())?;
+                }
+                path
+            }
+        };
+
+        if matches!(dockerfile, Dockerfile::File { .. }) {
+            if let Ok(cross_base_image) =
+                get_image_name(&self.config, &self.target, uses_zig)
+            {
+                docker_build.args([
+                    "--build-arg",
+                    &format!("CROSS_BASE_IMAGE={cross_base_image}"),
+                ]);
+            }
+        }
+
+        docker_build.args(["--file".into(), path]);
+
+        if let Some(build_opts) = self.config.build_opts() {
+            docker_build.args(Engine::parse_opts(&build_opts)?);
+        }
+
+        let has_output = self
+            .config
+            .build_opts()
+            .is_some_and(|opts| opts.contains("--load") || opts.contains("--output"));
+        if self.engine.kind.is_docker() && !has_output {
+            docker_build.args(["--output", "type=docker"]);
+        };
+
+        if let Some(context) = dockerfile.context() {
+            docker_build.arg(context);
+        } else {
+            docker_build.arg(paths.host_root());
+        }
+
+        // FIXME: Inspect the error message, while still inheriting stdout on verbose mode to
+        // conditionally apply this suggestion and note. This could then inspect if a help string is emitted,
+        // if the daemon is not running, etc.
+        docker_build
+            .run(msg_info, true)
+            .engine_warning(&self.engine)
+            .buildkit_warning()?;
+        Ok(image_name)
+    }
+}
