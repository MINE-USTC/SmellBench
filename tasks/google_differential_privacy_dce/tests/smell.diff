+func populateQuantileCount(bq *BoundedQuantiles, index int) error {
+	count, err := bq.Noise.AddNoiseFloat64(float64(bq.tree[index]), bq.l0Sensitivity, bq.lInfSensitivity, bq.epsilon, bq.delta)
+	if err != nil {
+		return err
+	}
+	bq.noisedTree[index] = count
+	return nil
+}
+
+func quantileChildrenTotal(bq *BoundedQuantiles, parent int) (float64, error) {
+	total := 0.0
+	leftmost, rightmost := bq.getLeftmostChild(parent), bq.getRightmostChild(parent)
+	for index := leftmost; index <= rightmost; index++ {
+		if _, found := bq.noisedTree[index]; !found {
+			if err := populateQuantileCount(bq, index); err != nil {
+				return 0, fmt.Errorf("couldn't get noised count for node %d: %w", index, err)
+			}
+		}
+		total += math.Max(0.0, bq.noisedTree[index])
+	}
+	return total, nil
+}
+
