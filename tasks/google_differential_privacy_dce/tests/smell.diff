diff --git a/go/dpagg/aggregation_state.go b/go/dpagg/aggregation_state.go
index fb86139..203d87e 100644
--- a/go/dpagg/aggregation_state.go
+++ b/go/dpagg/aggregation_state.go
@@ -16,6 +16,8 @@
 
 package dpagg
 
+import "fmt"
+
 type aggregationState int
 
 var errorMessages = map[int]string{
@@ -45,3 +47,46 @@ func (s aggregationState) errorMessage() string {
 func (s aggregationState) String() string {
 	return stateName[int(s)]
 }
+
+type aggregationOperation uint8
+
+const (
+	amendOperation aggregationOperation = iota
+	resultOperation
+	repeatResultOperation
+	intervalOperation
+	serializeOperation
+)
+
+func (s aggregationState) permits(op aggregationOperation) bool {
+	switch op {
+	case amendOperation, resultOperation:
+		return s == defaultState
+	case repeatResultOperation:
+		return s == defaultState || s == resultReturned
+	case intervalOperation:
+		return s == resultReturned
+	case serializeOperation:
+		return s == defaultState || s == serialized
+	}
+	return false
+}
+
+func aggregationAccess(s aggregationState, op aggregationOperation, message string) error {
+	if s.permits(op) {
+		return nil
+	}
+	return fmt.Errorf(message, s.errorMessage())
+}
+
+func beginAggregationResult(state *aggregationState, repeated bool, message string) error {
+	op := resultOperation
+	if repeated {
+		op = repeatResultOperation
+	}
+	if err := aggregationAccess(*state, op, message); err != nil {
+		return err
+	}
+	*state = resultReturned
+	return nil
+}
