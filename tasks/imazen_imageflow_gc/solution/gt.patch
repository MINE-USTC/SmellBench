-    ) -> sizing::Result<(Option<[u32; 4]>, sizing::Layout)> {
-        let (origin, layout, _, _) = Self::layout_measure(request)?;
-        let (precrop_w, precrop_h) = Self::layout_get_precrop(request);
-        let new_crop = layout.get_source_crop();
-        let (crop_x1, crop_y1) = origin;
-        let crop = if crop_x1 > 0
-            || crop_y1 > 0
-            || precrop_w != new_crop.width()
-            || precrop_h != new_crop.height()
-        {
-            Some([
-                crop_x1,
-                crop_y1,
-                crop_x1 + new_crop.width() as u32,
