-    fn layout_measure(
-        request: &Ir4Layout,
-    ) -> sizing::Result<((u32, u32), sizing::Layout, s::ResampleHints, f64)> {
-        // later consider adding f.sharpen, f.ignorealpha
-        // (up/down).(filter,window,blur,preserve,colorspace,speed)
-
-        let (precrop_w, precrop_h) = Self::layout_get_precrop(request);
-        let projected = Self::layout_project_copy_window(request, precrop_w, precrop_h);
-        let initial_crop = if projected[3] <= projected[1] || projected[2] <= projected[0] {
-            [0, 0, precrop_w, precrop_h]
-        } else {
-            projected
-        };
-
-        let initial_size = sizing::AspectRatio::create(
-            initial_crop[2] - initial_crop[0],
-            initial_crop[3] - initial_crop[1],
-        )?;
-
-        let target = Self::layout_get_ideal_target_size(
-            request,
-            initial_size,
-            Self::layout_get_preshrink_ratio(request),
-        )?;
-
-        let constraints = Self::layout_build_constraints(request);
-
-        //We would change this for face or ROI support
-        let cropper = sizing::IdentityCropProvider::new();
-
-        // ======== This is where we do the sizing and constraint evaluation \/
-        let layout =
-            sizing::Layout::create(initial_size, target).execute_all(&constraints, &cropper)?;
-
-        //println!("executed constraints {:?} to get layout {:?} from target {:?}", &constraints, &layout, &target);
-        let new_crop = layout.get_source_crop();
-
-        let image = layout.get_box(BoxTarget::CurrentImage);
-        let downscaling = image.width() < new_crop.width() || image.height() < new_crop.height();
-        let precise_ratio = request.i.min_precise_scaling_ratio.unwrap_or(2.1f32) as f64;
-        let reduction = (f64::from(new_crop.w) / f64::from(image.w))
-            .min(f64::from(new_crop.h) / f64::from(image.w));
-        let colorspace =
-            if downscaling { request.i.down_colorspace } else { request.i.up_colorspace };
-
-        let crop_align = request
-            .i
-            .c_gravity
-            .map(|[x, y]| (Anchor1D::Percent(x as f32), Anchor1D::Percent(y as f32)))
-            .or(request.i.anchor)
-            .unwrap_or((Anchor1D::Center, Anchor1D::Center));
-        //align crop
-        let (inner_crop_x1, inner_crop_y1) = Self::layout_align(crop_align, new_crop, initial_size)
-            .expect("Outer box should never be smaller than inner box. All values must > 0");
-        //add manual crop offset
-        let (crop_x1, crop_y1) =
-            ((initial_crop[0] + inner_crop_x1) as u32, (initial_crop[1] + inner_crop_y1) as u32);
-
-        let hints = s::ResampleHints {
-            sharpen_percent: request.i.f_sharpen,
-            down_filter: request.i.down_filter.map(|v| v.to_filter()),
-            up_filter: request.i.up_filter.map(|v| v.to_filter()),
-            scaling_colorspace: match colorspace {
-                Some(ScalingColorspace::Linear) => Some(s::ScalingFloatspace::Linear),
-                Some(ScalingColorspace::Srgb) => Some(s::ScalingFloatspace::Srgb),
-                _ => None,
-            },
-            background_color: None,
-            resample_when: Some(s::ResampleWhen::SizeDiffersOrSharpeningRequested),
-            sharpen_when: match request.i.f_sharpen_when {
-                Some(SharpenWhen::Downscaling) => Some(s::SharpenWhen::Downscaling),
-                Some(SharpenWhen::SizeDiffers) => Some(s::SharpenWhen::SizeDiffers),
-                Some(SharpenWhen::Always) => Some(s::SharpenWhen::Always),
-                None => None,
-            },
-        };
-        Ok(((crop_x1, crop_y1), layout, hints, precise_ratio / reduction))
-    }
