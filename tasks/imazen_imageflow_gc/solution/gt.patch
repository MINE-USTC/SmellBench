-            imageflow_types::ConstraintGravity::Percentage { x, y } => (x, y),
-        };
-        Ok((
-            Self::layout_gravity1d(x, inner.width(), outer.width())?,
-            Self::layout_gravity1d(y, inner.height(), outer.height())?,
