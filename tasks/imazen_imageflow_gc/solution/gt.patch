-    pub(super) fn layout_align1d(
-        a: Anchor1D,
-        inner: i32,
-        outer: i32,
-    ) -> std::result::Result<i32, ()> {
-        if outer < inner && inner < 1 || outer < 1 {
-            Err(())
-        } else {
-            match a {
-                Anchor1D::Near => Ok(0),
-                Anchor1D::Center => Ok((outer - inner) / 2),
-                Anchor1D::Far => Ok(outer - inner),
-                Anchor1D::Percent(p) => Self::layout_gravity1d(p, inner, outer),
-            }
-        }
-    }
