+        let h = Self::float_max(
+            1f64,
+            Self::float_min((f64::from(h) * zoom).round(), f64::from(i32::MAX)).unwrap(),
+        )
+        .unwrap() as i32;
+
+        AspectRatio::create(w, h)
+    }
