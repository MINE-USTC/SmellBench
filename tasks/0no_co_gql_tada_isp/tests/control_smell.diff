+import { printSchema } from 'graphql';
+import type { GraphQLSchema } from 'graphql';
+import {
+  minifyIntrospection,
+  preprocessIntrospection,
+  outputIntrospectionFile,
+  extractIntrospectionHeader,
+} from './introspection';
+import type {
+  SchemaLoader,
+  SchemaLoaderResult,
+  SchemaRef,
+  BaseLoadConfig,
+  SingleSchemaInput,
+  MultiSchemaInput,
+  LoadConfig,
+  OnSchemaUpdate,
+  OnSchemaError,
+} from './loaders';
+
+export interface SchemaOperations {
+  minifyIntrospection: typeof minifyIntrospection;
+  preprocessIntrospection: typeof preprocessIntrospection;
+  outputIntrospectionFile: typeof outputIntrospectionFile;
+  extractIntrospectionHeader: typeof extractIntrospectionHeader;
+  printSchema: typeof printSchema;
+  createDiagnosticsRef: typeof createDiagnosticsRef;
+  collectSchemas: typeof collectSchemas;
+}
+
+const outputOperations: SchemaOperations = {
+  minifyIntrospection,
+  preprocessIntrospection,
+  outputIntrospectionFile,
+  extractIntrospectionHeader,
+  printSchema,
+  createDiagnosticsRef,
+  collectSchemas,
+};
+
+export interface SchemaSubscriberOperations extends SchemaOperations {
+  updates: Set<OnSchemaUpdate>;
+  errors: Set<OnSchemaError>;
+  subscribe(update: OnSchemaUpdate, error?: OnSchemaError): void;
+  unsubscribe(update: OnSchemaUpdate, error?: OnSchemaError): void;
+}
+
+export function schemaSubscriberOperations(): SchemaSubscriberOperations {
+  const updates = new Set<OnSchemaUpdate>();
+  const errors = new Set<OnSchemaError>();
+  return {
+    ...outputOperations,
+    updates,
+    errors,
+    subscribe(update, error) {
+      updates.add(update);
+      if (error) errors.add(error);
+    },
+    unsubscribe(update, error) {
+      updates.delete(update);
+      if (error) errors.delete(error);
+    },
+  };
+}
+
+function createDiagnosticsRef(ref: SchemaRef<SchemaLoaderResult>) {
+  return {
+    current: ref.current,
+    multi: ref.multi,
+    version: ref.version,
+    errors: {
+      config: null,
+      load: new Map<string | null, string>(),
+      write: new Map<string, string>(),
+    },
+    outputLocations: new Map<string, number>(),
+    sourceLocations: new Map<string | null, string>(),
+    turboLocations: new Map<string | null, string>(),
+    checkStale() {},
+  };
+}
+
+function collectSchemas(ref: SchemaRef): Map<string | null, GraphQLSchema> {
+  const schemas = new Map<string | null, GraphQLSchema>();
+  if (ref.current) schemas.set(null, ref.current.schema);
+  for (const name in ref.multi) {
+    const result = ref.multi[name];
+    if (result) schemas.set(name, result.schema);
+  }
+  return schemas;
+}
+
+export function schemaOperations<T extends SchemaLoader | SchemaRef>(
+  source: T
+): T & SchemaOperations {
+  return Object.assign(source, outputOperations);
+}
+
+export interface SchemaReferenceOperations extends SchemaOperations {
+  publishResult(
+    ref: SchemaRef,
+    input: SingleSchemaInput,
+    result: SchemaLoaderResult
+  ): SchemaLoaderResult & { name?: string };
+  getLoaders(config?: BaseLoadConfig): { input: SingleSchemaInput; loader: SchemaLoader }[];
+  retainTeardowns(...teardowns: (() => void)[]): void;
+  stopUpdates(): void;
+}
+
+export function schemaReferenceOperations(
+  input: SingleSchemaInput | MultiSchemaInput | (SingleSchemaInput & MultiSchemaInput),
+  createLoader: (config: LoadConfig) => SchemaLoader
+): SchemaReferenceOperations {
+  const teardowns: (() => void)[] = [];
+  let loaders: { input: SingleSchemaInput; loader: SchemaLoader }[] | undefined;
+  return {
+    ...outputOperations,
+    publishResult(ref, input, result) {
+      ref.version++;
+      return { ...input, ...result };
+    },
+    getLoaders(config) {
+      if (!loaders) {
+        loaders = (('schemas' in input && input.schemas) || []).map((input) => ({
+          input,
+          loader: createLoader({ ...config, origin: input.schema, name: input.name }),
+        }));
+        if ('schema' in input && input.schema) {
+          loaders.push({
+            input: { ...input, name: undefined },
+            loader: createLoader({ ...config, origin: input.schema }),
+          });
+        }
+      }
+      return loaders;
+    },
+    retainTeardowns(...next) {
+      teardowns.push(...next);
+    },
+    stopUpdates() {
+      let teardown: (() => void) | undefined;
+      while ((teardown = teardowns.pop()) != null) teardown();
+    },
+  };
+}
+
+export function schemaLoaderOperations(
+  source: Pick<SchemaLoader, 'name' | 'load' | 'notifyOnUpdate'>
+): SchemaLoader & SchemaOperations {
+  return schemaOperations(
+    Object.assign(source, {
+      async loadIntrospection(this: SchemaLoader) {
+        const result = await this.load();
+        return result && result.introspection;
+      },
+      async loadSchema(this: SchemaLoader) {
+        const result = await this.load();
+        return result && result.schema;
+      },
+    })
+  );
+}
