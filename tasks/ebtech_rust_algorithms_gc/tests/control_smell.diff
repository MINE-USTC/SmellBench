+++ b/src/graph/engine.rs
@@ -0,0 +1,338 @@
+//! Graph operation implementations.
+use super::{Graph, connectivity::ConnectivityGraph, flow::FlowGraph, util::DfsIterator};
+
+enum TraversalStep {
+    Edge { from: usize, edge: usize, to: usize, discovered: bool },
+    Leave(usize),
+}
+
+/// Helper struct that carries data needed for the depth-first searches in
+/// ConnectivityGraph's constructor.
+struct ConnectivityData {
+    time: usize,
+    vis: Box<[usize]>,
+    low: Box<[usize]>,
+    v_stack: Vec<usize>,
+    e_stack: Vec<usize>,
+}
+
+impl ConnectivityData {
+    fn new(num_v: usize) -> Self {
+        Self {
+            time: 0,
+            vis: vec![0; num_v].into_boxed_slice(),
+            low: vec![0; num_v].into_boxed_slice(),
+            v_stack: vec![],
+            e_stack: vec![],
+        }
+    }
+
+    fn visit(&mut self, u: usize) {
+        self.time += 1;
+        self.vis[u] = self.time;
+        self.low[u] = self.time;
+        self.v_stack.push(u);
+    }
+
+    fn lower(&mut self, u: usize, val: usize) {
+        if self.low[u] > val {
+            self.low[u] = val
+        }
+    }
+}
+
+
+impl Graph {
+    pub(super) fn fill_components(&self, connect: &mut ConnectivityGraph, is_directed: bool) {
+        let mut data = ConnectivityData::new(self.num_v());
+        let mut walk = DfsIterator {
+            graph: self, visited: vec![false; self.num_v()],
+            stack: Vec::new(), cursors: self.first.clone(),
+        };
+        let mut incoming = vec![None; self.num_v()];
+        for root in 0..self.num_v() {
+            if walk.visited[root] { continue; }
+            walk.visited[root] = true;
+            walk.stack.push(root);
+            data.visit(root);
+            while let Some(step) = Self::advance_traversal(&mut walk) {
+                match step {
+                    TraversalStep::Edge { from: u, edge: e, to: v, discovered } => {
+                        if discovered {
+                            incoming[v] = Some(e);
+                            if !is_directed { data.e_stack.push(e); }
+                            data.visit(v);
+                        } else if is_directed {
+                            if connect.cc[v] == 0 { data.lower(u, data.low[v]); }
+                        } else if data.vis[v] < data.vis[u]
+                            && e ^ incoming[u].unwrap_or(self.num_e() + 1) != 1 {
+                            data.lower(u, data.vis[v]);
+                            data.e_stack.push(e);
+                        } else if v == u {
+                            connect.num_vcc += 1;
+                            connect.vcc[e] = connect.num_vcc;
+                            connect.vcc[e ^ 1] = connect.num_vcc;
+                        }
+                    }
+                    TraversalStep::Leave(v) => {
+                        if data.vis[v] == data.low[v] {
+                            connect.num_cc += 1;
+                            while let Some(top) = data.v_stack.pop() {
+                                connect.cc[top] = connect.num_cc;
+                                if top == v { break; }
+                            }
+                        }
+                        if let Some(&u) = walk.stack.last() {
+                            if !is_directed || connect.cc[v] == 0 {
+                                data.lower(u, data.low[v]);
+                            }
+                            if !is_directed && data.vis[u] <= data.low[v] {
+                                connect.num_vcc += 1;
+                                let e = incoming[v].unwrap();
+                                while let Some(top) = data.e_stack.pop() {
+                                    connect.vcc[top] = connect.num_vcc;
+                                    connect.vcc[top ^ 1] = connect.num_vcc;
+                                    if e ^ top <= 1 { break; }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    pub(super) fn components_two_sat_assign(&self, connect: &ConnectivityGraph) -> Option<Vec<bool>> {
+        (0..self.num_v() / 2)
+            .map(|i| {
+                let scc_true = connect.cc[2 * i];
+                let scc_false = connect.cc[2 * i + 1];
+                if scc_true == scc_false {
+                    None
+                } else {
+                    Some(scc_true < scc_false)
+                }
+            })
+            .collect()
+    }
+    pub(super) fn components_topological_sort(&self, connect: &ConnectivityGraph) -> Vec<usize> {
+        let mut vertices = (0..self.num_v()).collect::<Vec<_>>();
+        vertices.sort_unstable_by_key(|&u| connect.num_cc - connect.cc[u]);
+        vertices
+    }
+    pub(super) fn components_is_cut_vertex(&self, connect: &ConnectivityGraph, u: usize) -> bool {
+        if let Some(first_e) = self.first[u] {
+            self
+                .adj_list(u)
+                .any(|(e, _)| connect.vcc[first_e] != connect.vcc[e])
+        } else {
+            false
+        }
+    }
+    pub(super) fn components_is_cut_edge(&self, connect: &ConnectivityGraph, e: usize) -> bool {
+        let u = self.endp[e ^ 1];
+        let v = self.endp[e];
+        connect.cc[u] != connect.cc[v]
+    }
+}
+
+impl Graph {
+    pub(super) fn network_add_edge(&mut self, capacities: &mut Vec<i64>, costs: &mut Vec<i64>, u: usize, v: usize, cap: i64, rcap: i64, cost: i64) {
+        capacities.push(cap);
+        capacities.push(rcap);
+        costs.push(cost);
+        costs.push(-cost);
+        for (from, to) in [(u, v), (v, u)] {
+            self.next.push(self.first[from]);
+            self.first[from] = Some(self.endp.len());
+            self.endp.push(to);
+        }
+    }
+
+    pub(super) fn network_dinic(&self, network: &FlowGraph, s: usize, t: usize) -> (i64, Vec<i64>) {
+        let mut flow = vec![0; self.num_e()];
+        let mut max_flow = 0;
+        loop {
+            let (dist, mut adj_iters) = self.network_dinic_search(network, s, &flow);
+            if dist[t] == i64::MAX {
+                break;
+            }
+            // Keep track of adjacency lists to avoid revisiting blocked edges.
+            max_flow += self.network_dinic_augment(network, s, t, i64::MAX, &dist, &mut adj_iters, &mut flow);
+        }
+        (max_flow, flow)
+    }
+    fn network_dinic_search(&self, network: &FlowGraph, s: usize, flow: &[i64]) -> (Vec<i64>, Vec<Option<usize>>) {
+        let mut dist = vec![i64::MAX; self.num_v()];
+        let mut adj = vec![None; self.num_v()];
+        let mut q = ::std::collections::VecDeque::new();
+        dist[s] = 0;
+        q.push_back(s);
+        while let Some(u) = q.pop_front() {
+            let mut next = self.first[u];
+            while let Some(e) = next {
+                let v = self.endp[e];
+                next = self.next[e];
+                if dist[v] == i64::MAX && flow[e] < network.cap[e] {
+                    dist[v] = dist[u] + 1;
+                    q.push_back(v);
+                }
+                if adj[u].is_none() && dist[v] == dist[u] + 1 && flow[e] < network.cap[e] {
+                    adj[u] = Some(e);
+                }
+            }
+        }
+        (dist, adj)
+    }
+    fn network_dinic_augment(
+        &self, network: &FlowGraph,
+        u: usize,
+        t: usize,
+        f: i64,
+        dist: &[i64],
+        adj: &mut [Option<usize>],
+        flow: &mut [i64],
+    ) -> i64 {
+        let mut pending = vec![(u, f, 0)];
+        loop {
+            let &(vertex, limit, sent) = pending.last().unwrap();
+            if vertex != t && sent < limit {
+                if let Some(e) = adj[vertex] {
+                    let v = self.endp[e];
+                    let available = (network.cap[e] - flow[e]).min(limit - sent);
+                    if available > 0 && dist[v] == dist[vertex] + 1 {
+                        pending.push((v, available, 0));
+                        continue;
+                    }
+                    adj[vertex] = self.next[e];
+                    continue;
+                }
+            }
+            let returned = if vertex == t { limit } else { sent };
+            pending.pop();
+            if let Some(parent) = pending.last_mut() {
+                let e = adj[parent.0].unwrap();
+                flow[e] += returned;
+                flow[e ^ 1] -= returned;
+                parent.2 += returned;
+                if parent.2 < parent.1 {
+                    adj[parent.0] = self.next[e];
+                }
+            } else {
+                return returned;
+            }
+        }
+    }
+    pub(super) fn network_min_cut(&self, dist: &[i64]) -> Vec<usize> {
+        (0..self.num_e())
+            .filter(|&e| {
+                let u = self.endp[e ^ 1];
+                let v = self.endp[e];
+                dist[u] < i64::MAX && dist[v] == i64::MAX
+            })
+            .collect()
+    }
+    pub(super) fn network_mcf(&self, network: &FlowGraph, s: usize, t: usize) -> (i64, i64, Vec<i64>) {
+        let mut pot = vec![0; self.num_v()];
+
+        // Bellman-Ford deals with negative-cost edges at initialization.
+        for _ in 1..self.num_v() {
+            for e in 0..self.num_e() {
+                if network.cap[e] > 0 {
+                    let u = self.endp[e ^ 1];
+                    let v = self.endp[e];
+                    pot[v] = pot[v].min(pot[u] + network.cost[e]);
+                }
+            }
+        }
+
+        let mut flow = vec![0; self.num_e()];
+        let (mut min_cost, mut max_flow) = (0, 0);
+        loop {
+            let (path, df) = self.network_mcf_search(network, s, t, &flow, &mut pot);
+            if path.is_empty() { break; }
+            let mut dc = 0;
+            for e in path {
+                flow[e] += df;
+                flow[e ^ 1] -= df;
+                dc += df * network.cost[e];
+            }
+            min_cost += dc;
+            max_flow += df;
+        }
+        (min_cost, max_flow, flow)
+    }
+    fn network_mcf_search(&self, network: &FlowGraph, s: usize, t: usize, flow: &[i64], pot: &mut [i64]) -> (Vec<usize>, i64) {
+        let mut vis = vec![false; self.num_v()];
+        let mut dist = vec![i64::MAX; self.num_v()];
+        let mut par = vec![None; self.num_v()];
+
+        dist[s] = 0;
+        while let Some(u) = (0..self.num_v())
+            .filter(|&u| !vis[u] && dist[u] < i64::MAX)
+            .min_by_key(|&u| dist[u] - pot[u])
+        {
+            vis[u] = true;
+            pot[u] = dist[u];
+            let mut next = self.first[u];
+            while let Some(e) = next {
+                let v = self.endp[e];
+                next = self.next[e];
+                if dist[v] > dist[u] + network.cost[e] && flow[e] < network.cap[e] {
+                    dist[v] = dist[u] + network.cost[e];
+                    par[v] = Some(e);
+                }
+            }
+        }
+        let mut path = Vec::new();
+        let mut df = i64::MAX;
+        let mut u = t;
+        while let Some(e) = par[u] {
+            df = df.min(network.cap[e] - flow[e]);
+            path.push(e);
+            u = self.endp[e ^ 1];
+        }
+        (path, df)
+    }
+}
+
+impl Graph {
+    pub(super) fn set_representative(parent: &mut [usize], u: usize) -> usize {
+        let pu = parent[u];
+        if pu != u {
+            parent[u] = Self::set_representative(parent, pu);
+        }
+        parent[u]
+    }
+
+    pub(super) fn merge_sets(parent: &mut [usize], u: usize, v: usize) -> bool {
+        let (pu, pv) = (Self::set_representative(parent, u), Self::set_representative(parent, v));
+        parent[pu] = pv;
+        pu != pv
+    }
+
+    pub(super) fn next_traversal(iter: &mut DfsIterator) -> Option<(usize, usize)> {
+        while let Some(step) = Self::advance_traversal(iter) {
+            if let TraversalStep::Edge { edge, to, discovered: true, .. } = step {
+                return Some((edge, to));
+            }
+        }
+        None
+    }
+
+    fn advance_traversal(iter: &mut DfsIterator) -> Option<TraversalStep> {
+        let &u = iter.stack.last()?;
+        if let Some(e) = iter.cursors[u] {
+            let v = iter.graph.endp[e];
+            iter.cursors[u] = iter.graph.next[e];
+            let discovered = !iter.visited[v];
+            if discovered {
+                iter.visited[v] = true;
+                iter.stack.push(v);
+            }
+            Some(TraversalStep::Edge { from: u, edge: e, to: v, discovered })
+        } else {
+            iter.stack.pop();
+            Some(TraversalStep::Leave(u))
+        }
+    }
+}
