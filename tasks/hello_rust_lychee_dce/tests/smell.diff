+use super::WebsiteChecker;
+use crate::Status;
+use http::Method;
+use reqwest::Request;
+
+pub(super) async fn exchange(checker: &WebsiteChecker, request: Request) -> Status {
+    let url = request.url().clone();
+    let fragments = checker.fragment_checker_options.any_enabled()
+        && request.method() == Method::GET
+        && url.fragment().is_some_and(|fragment| !fragment.is_empty());
+    checker.check_response(request, url, fragments).await
+}
