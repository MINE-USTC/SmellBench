@@ -0,0 +1,24 @@
+use super::WebsiteChecker;
+use crate::{ErrorKind, Status, ratelimit::CacheableResponse};
+use url::Url;
+
+pub(super) async fn validate(
+    checker: &WebsiteChecker,
+    url: Url,
+    status: Status,
+    response: &mut CacheableResponse,
+    requested: bool,
+) -> Status {
+    let input = response.take_fragment_input();
+    if !requested || !response.status.is_success() {
+        return status;
+    }
+    let Some(input) = input else {
+        return status;
+    };
+    match checker.fragment_checker.check(input, &url, checker.fragment_checker_options).await {
+        Ok(true) => status,
+        Ok(false) => ErrorKind::InvalidFragment(url.into()).into(),
+        Err(error) => error.into(),
+    }
+}
