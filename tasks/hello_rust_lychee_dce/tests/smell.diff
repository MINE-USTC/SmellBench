+pub(crate) struct RetrySchedule {
+    remaining: u64,
+    delay: std::time::Duration,
+}
+
+impl RetrySchedule {
+    pub(crate) fn new(remaining: u64, delay: std::time::Duration) -> Self {
+        Self { remaining, delay }
+    }
+
+    pub(crate) fn next_delay(&mut self, status: &Status) -> Option<std::time::Duration> {
+        if self.remaining == 0 || status.is_success() || !status.should_retry() {
+            return None;
+        }
+        self.remaining -= 1;
+        let delay = self.delay;
+        self.delay = delay.saturating_mul(2);
+        Some(delay)
+    }
+}
