 impl CacheableResponse {
+    pub(crate) fn take_fragment_input(&mut self) -> Option<crate::utils::fragment_checker::FragmentInput<'static>> {
+        use crate::FileType;
+        use reqwest::header::CONTENT_TYPE;
+        let content = self.text.take()?;
+        let content_type = self.headers.get(CONTENT_TYPE)?.to_str().ok()?;
+        let file_type = if content_type.starts_with("text/html") {
+            FileType::Html
+        } else if content_type.starts_with("text/markdown") {
+            FileType::Markdown
+        } else if content_type.starts_with("text/plain")
+            && std::path::Path::new(self.url.path()).extension().is_some_and(|ext| ext.eq_ignore_ascii_case("md"))
+        {
+            FileType::Markdown
+        } else {
+            return None;
+        };
+        Some(crate::utils::fragment_checker::FragmentInput {
+            content: std::borrow::Cow::Owned(content),
+            file_type,
+        })
+    }
