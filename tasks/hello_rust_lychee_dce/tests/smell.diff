+use super::{WebsiteChecker, clone_unwrap};
+use crate::{Status, chain::{ChainResult, Handler}, retry::RetrySchedule};
+use async_trait::async_trait;
+use reqwest::Request;
+
+#[derive(Debug)]
+pub(super) struct Transport(pub(super) WebsiteChecker);
+
+#[async_trait]
+impl Handler<Request, Status> for Transport {
+    async fn handle(&mut self, request: Request) -> ChainResult<Request, Status> {
+        ChainResult::Done(self.0.retry_request(request).await)
+    }
+}
+
+pub(super) async fn retry(
+    checker: &WebsiteChecker,
+    request: &Request,
+    mut status: Status,
+    retries: &mut u64,
+    wait_time: &mut std::time::Duration,
+) -> Status {
+    let mut schedule = RetrySchedule::new(checker.max_retries - *retries, *wait_time);
+    while let Some(delay) = schedule.next_delay(&status) {
+        *retries += 1;
+        tokio::time::sleep(delay).await;
+        *wait_time = delay.saturating_mul(2);
+        status = super::exchange::exchange(checker, clone_unwrap(request)).await;
+    }
+    status
+}
