@@ -0,0 +1,237 @@
+package btree
+
+type nodeAccess[I, N any] interface {
+	lessItem(a, b I) bool
+	loadNode(cn **N, mut bool) *N
+	makeNode(leaf bool) *N
+	copyNode(n *N) *N
+	zeroItem() I
+	nodeLimits() (int, int)
+	initialize(degree int)
+	rootNode() **N
+	itemCount() int
+	cloneEnabled() bool
+	cloneItem(item I) I
+	locateNode(cn **N, key I, mut bool) (*N, int, bool)
+	cursor(mut bool) nodeAccess[I, N]
+}
+
+type treeAccess[T any] interface {
+	nodeAccess[T, node[T]]
+	acquire(write bool) bool
+	release(write bool)
+	findNode(n *node[T], key T, hint *PathHint, depth int) (int, bool)
+	locateHint(cn **node[T], key T, hint *PathHint, depth int, mut bool) (*node[T], int, bool)
+	openIteration(mut bool) (treeAccess[T], bool)
+}
+
+type treeBinding[T any] struct {
+	tree *BTreeG[T]
+}
+
+type treeCursorBinding[T any] struct {
+	treeAccess[T]
+	mutable bool
+}
+
+func (b treeBinding[T]) cursor(mut bool) nodeAccess[T, node[T]] {
+	return treeCursorBinding[T]{treeAccess: b, mutable: mut}
+}
+
+func (b treeBinding[T]) openIteration(mut bool) (treeAccess[T], bool) {
+	access := b.cursor(mut).(treeAccess[T])
+	return access, access.acquire(mut)
+}
+
+func (b treeCursorBinding[T]) loadNode(cn **node[T], mut bool) *node[T] {
+	return b.treeAccess.loadNode(cn, b.mutable)
+}
+
+func (b treeCursorBinding[T]) locateNode(cn **node[T], key T, mut bool) (*node[T], int, bool) {
+	return b.treeAccess.locateNode(cn, key, b.mutable)
+}
+
+func (b treeCursorBinding[T]) locateHint(cn **node[T], key T, hint *PathHint, depth int, mut bool) (*node[T], int, bool) {
+	return b.treeAccess.locateHint(cn, key, hint, depth, b.mutable)
+}
+
+func (b treeCursorBinding[T]) release(write bool) {
+	b.treeAccess.release(b.mutable)
+}
+
+func (tr *BTreeG[T]) binding() treeAccess[T] {
+	if tr.service != nil && tr.service.rootNode() == &tr.root {
+		return tr.service
+	}
+	return treeBinding[T]{tree: tr}
+}
+
+func (b treeBinding[T]) lessItem(a, c T) bool { return b.tree.less(a, c) }
+func (b treeBinding[T]) loadNode(cn **node[T], mut bool) *node[T] {
+	return b.tree.isoLoad(cn, mut)
+}
+func (b treeBinding[T]) makeNode(leaf bool) *node[T]  { return b.tree.newNode(leaf) }
+func (b treeBinding[T]) copyNode(n *node[T]) *node[T] { return b.tree.copy(n) }
+func (b treeBinding[T]) zeroItem() T                  { return b.tree.empty }
+func (b treeBinding[T]) nodeLimits() (int, int)       { return b.tree.min, b.tree.max }
+func (b treeBinding[T]) initialize(degree int)        { b.tree.init(degree) }
+func (b treeBinding[T]) rootNode() **node[T]          { return &b.tree.root }
+func (b treeBinding[T]) itemCount() int               { return b.tree.count }
+func (b treeBinding[T]) acquire(write bool) bool      { return b.tree.lock(write) }
+func (b treeBinding[T]) release(write bool)           { b.tree.unlock(write) }
+
+func (b treeBinding[T]) findNode(n *node[T], key T, hint *PathHint, depth int) (int, bool) {
+	return b.tree.find(n, key, hint, depth)
+}
+
+func (b treeBinding[T]) locateNode(cn **node[T], key T, mut bool) (*node[T], int, bool) {
+	n := b.loadNode(cn, mut)
+	i, found := searchItems[T, node[T]](b, n.items, key)
+	return n, i, found
+}
+
+func (b treeBinding[T]) locateHint(cn **node[T], key T, hint *PathHint, depth int, mut bool) (*node[T], int, bool) {
+	n := *cn
+	if mut && n.isoid != b.tree.isoid {
+		*cn = b.copyNode(n)
+		n = *cn
+	}
+	if hint == nil {
+		i, found := searchItems[T, node[T]](b, n.items, key)
+		return n, i, found
+	}
+	i, found := b.tree.hintsearch(n, key, hint, depth)
+	return n, i, found
+}
+
+func (b treeBinding[T]) cloneEnabled() bool {
+	return b.tree.copyItems || b.tree.isoCopyItems
+}
+
+func (b treeBinding[T]) cloneItem(item T) T {
+	if b.tree.copyItems {
+		return any(item).(copier[T]).Copy()
+	}
+	if b.tree.isoCopyItems {
+		return any(item).(isoCopier[T]).IsoCopy()
+	}
+	return item
+}
+
+type mapBinding[K ordered, V any] struct {
+	tree *Map[K, V]
+}
+
+type mapCursorBinding[K ordered, V any] struct {
+	nodeAccess[mapPair[K, V], mapNode[K, V]]
+	mutable bool
+}
+
+func (b mapBinding[K, V]) cursor(mut bool) nodeAccess[mapPair[K, V], mapNode[K, V]] {
+	return mapCursorBinding[K, V]{nodeAccess: b, mutable: mut}
+}
+
+func (b mapCursorBinding[K, V]) loadNode(cn **mapNode[K, V], mut bool) *mapNode[K, V] {
+	return b.nodeAccess.loadNode(cn, b.mutable)
+}
+
+func (b mapCursorBinding[K, V]) locateNode(cn **mapNode[K, V], key mapPair[K, V], mut bool) (*mapNode[K, V], int, bool) {
+	return b.nodeAccess.locateNode(cn, key, b.mutable)
+}
+
+func (tr *Map[K, V]) binding() nodeAccess[mapPair[K, V], mapNode[K, V]] {
+	if tr.service != nil && tr.service.rootNode() == &tr.root {
+		return tr.service
+	}
+	return mapBinding[K, V]{tree: tr}
+}
+
+func (b mapBinding[K, V]) lessItem(a, c mapPair[K, V]) bool { return a.key < c.key }
+func (b mapBinding[K, V]) loadNode(cn **mapNode[K, V], mut bool) *mapNode[K, V] {
+	return b.tree.isoLoad(cn, mut)
+}
+func (b mapBinding[K, V]) makeNode(leaf bool) *mapNode[K, V]        { return b.tree.newNode(leaf) }
+func (b mapBinding[K, V]) copyNode(n *mapNode[K, V]) *mapNode[K, V] { return b.tree.copy(n) }
+func (b mapBinding[K, V]) zeroItem() mapPair[K, V]                  { return b.tree.empty }
+func (b mapBinding[K, V]) nodeLimits() (int, int)                   { return b.tree.min, b.tree.max }
+func (b mapBinding[K, V]) initialize(degree int)                    { b.tree.init(degree) }
+func (b mapBinding[K, V]) rootNode() **mapNode[K, V]                { return &b.tree.root }
+func (b mapBinding[K, V]) itemCount() int                           { return b.tree.count }
+
+func (b mapBinding[K, V]) cloneEnabled() bool {
+	return b.tree.copyValues || b.tree.isoCopyValues
+}
+
+func (b mapBinding[K, V]) cloneItem(item mapPair[K, V]) mapPair[K, V] {
+	if b.tree.copyValues {
+		item.value = any(item.value).(copier[V]).Copy()
+	} else if b.tree.isoCopyValues {
+		item.value = any(item.value).(isoCopier[V]).IsoCopy()
+	}
+	return item
+}
+
+func (b mapBinding[K, V]) locateNode(cn **mapNode[K, V], key mapPair[K, V], mut bool) (*mapNode[K, V], int, bool) {
+	n := *cn
+	if mut && n.isoid != b.tree.isoid {
+		*cn = b.copyNode(n)
+		n = *cn
+	}
+	i, found := searchItems[mapPair[K, V], mapNode[K, V]](b, n.items, key)
+	return n, i, found
+}
+
+func searchItems[I, N any](access nodeAccess[I, N], items []I, key I) (int, bool) {
+	low, high := 0, len(items)
+	for low < high {
+		h := int(uint(low+high) >> 1)
+		if !access.lessItem(key, items[h]) {
+			low = h + 1
+		} else {
+			high = h
+		}
+	}
+	if low > 0 && !access.lessItem(items[low-1], key) {
+		return low - 1, true
+	}
+	return low, false
+}
+
+func readTree[T any](access treeAccess[T], key T, hint *PathHint, mut bool) (T, bool) {
+	if access.acquire(mut) {
+		defer access.release(mut)
+	}
+	root := access.rootNode()
+	if *root == nil {
+		return access.zeroItem(), false
+	}
+	cn := root
+	for depth := 0; ; depth++ {
+		n, i, found := access.locateHint(cn, key, hint, depth, mut)
+		if found {
+			return n.items[i], true
+		}
+		if n.children == nil {
+			return access.zeroItem(), false
+		}
+		cn = &(*n.children)[i]
+	}
+}
+
+func readMap[K ordered, V any](access nodeAccess[mapPair[K, V], mapNode[K, V]], key K, mut bool) (V, bool) {
+	root := access.rootNode()
+	if *root == nil {
+		return access.zeroItem().value, false
+	}
+	cn := root
+	for {
+		n, i, found := access.locateNode(cn, mapPair[K, V]{key: key}, mut)
+		if found {
+			return n.items[i].value, true
+		}
+		if n.leaf() {
+			return access.zeroItem().value, false
+		}
+		cn = &(*n.children)[i]
+	}
+}
